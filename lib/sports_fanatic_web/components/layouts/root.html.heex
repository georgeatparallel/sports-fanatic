<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#2563eb" />

    <.live_title suffix={SportsFanaticWeb.SEO.title_suffix()}>
      <%= assigns[:page_title] || SportsFanaticWeb.SEO.default_title() %>
    </.live_title>

    <.seo_meta
      title={assigns[:og_title] || assigns[:page_title] || SportsFanaticWeb.SEO.default_title()}
      description={
        assigns[:og_description] || assigns[:meta_description] ||
          SportsFanaticWeb.SEO.default_description()
      }
      canonical_url={SportsFanaticWeb.SEO.canonical_or_request_url(assigns)}
      og_type={assigns[:og_type] || "website"}
      og_image={
        SportsFanaticWeb.SEO.absolute_image_url(
          assigns[:og_image] || SportsFanaticWeb.SEO.default_og_image_path()
        )
      }
      og_image_width={assigns[:og_image_width] || 1200}
      og_image_height={assigns[:og_image_height] || 630}
      og_image_alt={assigns[:og_image_alt] || SportsFanaticWeb.SEO.default_og_image_alt()}
      twitter_card={assigns[:twitter_card] || "summary_large_image"}
      twitter_site={SportsFanaticWeb.SEO.twitter_handle()}
      article_published_time={assigns[:article_published_time]}
      article_author={assigns[:article_author]}
      article_section={assigns[:article_section]}
    />

    <link rel="apple-touch-icon" href={~p"/images/og-default.png"} />
    <link rel="icon" type="image/x-icon" href={~p"/favicon.ico"} />

    <%= if assigns[:json_ld] do %>
      <script type="application/ld+json">
        <%= raw(if is_binary(@json_ld), do: @json_ld, else: Jason.encode!(@json_ld)) %>
      </script>
    <% end %>

    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="bg-gray-50 antialiased min-h-screen flex flex-col">
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-14 items-center">
          <div class="flex items-center gap-2">
            <a href="/" class="flex items-center gap-2 shrink-0">
              <span class="text-2xl">&#9918;</span>
              <span class="text-lg font-bold bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">
                Sports Fan Agent
              </span>
            </a>
            <div class="hidden md:flex items-center gap-1 ml-6">
              <a
                href="/mlb/teams"
                class="text-gray-600 hover:text-gray-900 hover:bg-gray-100 text-sm font-medium px-3 py-2 rounded-lg transition"
              >
                Teams
              </a>
              <a
                href="/chat"
                class="text-gray-600 hover:text-gray-900 hover:bg-gray-100 text-sm font-medium px-3 py-2 rounded-lg transition"
              >
                Chat
              </a>
              <a
                href="/mlb/news"
                class="text-gray-600 hover:text-gray-900 hover:bg-gray-100 text-sm font-medium px-3 py-2 rounded-lg transition"
              >
                News
              </a>
              <a
                href="/predictions"
                class="text-gray-600 hover:text-gray-900 hover:bg-gray-100 text-sm font-medium px-3 py-2 rounded-lg transition"
              >
                Predictions
              </a>
              <a
                href={"/mlb/lineups/#{Date.to_iso8601(SportsFanatic.DateHelper.today())}"}
                class="text-gray-600 hover:text-gray-900 hover:bg-gray-100 text-sm font-medium px-3 py-2 rounded-lg transition"
              >
                Players
              </a>
              <a
                href="/feeds"
                class="text-gray-600 hover:text-gray-900 hover:bg-gray-100 text-sm font-medium px-3 py-2 rounded-lg transition"
              >
                Manage Feeds
              </a>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <%= if assigns[:current_user] do %>
              <a
                href="/premium/dashboard"
                class="text-sm text-blue-600 font-medium hover:text-blue-700"
              >
                Dashboard
              </a>
              <.link
                href="/logout"
                method="delete"
                class="text-sm text-gray-500 hover:text-gray-700"
              >
                Sign Out
              </.link>
            <% else %>
              <%= if SportsFanatic.FeatureFlags.enabled?("subscriptions_enabled") do %>
                <a
                  href="/auth/login"
                  class="hidden sm:inline-block text-sm text-gray-600 hover:text-gray-900 font-medium"
                >
                  Sign In
                </a>
                <a
                  href="/subscribe"
                  class="bg-blue-600 text-white text-sm px-4 py-2 rounded-lg hover:bg-blue-700 font-medium transition shadow-sm"
                >
                  Subscribe
                </a>
              <% end %>
            <% end %>
            <!-- Mobile menu button -->
            <button
              type="button"
              onclick="document.getElementById('mobile-menu').classList.toggle('hidden')"
              class="md:hidden inline-flex items-center justify-center p-2 rounded-lg text-gray-500 hover:text-gray-900 hover:bg-gray-100"
            >
              <svg
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
                />
              </svg>
            </button>
          </div>
        </div>
        <!-- Mobile menu -->
        <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 py-3 space-y-1">
          <a
            href="/mlb/teams"
            class="block text-gray-600 hover:text-gray-900 hover:bg-gray-50 text-sm font-medium px-3 py-2 rounded-lg"
          >
            Teams
          </a>
          <a
            href="/chat"
            class="block text-gray-600 hover:text-gray-900 hover:bg-gray-50 text-sm font-medium px-3 py-2 rounded-lg"
          >
            Chat
          </a>
          <a
            href="/mlb/news"
            class="block text-gray-600 hover:text-gray-900 hover:bg-gray-50 text-sm font-medium px-3 py-2 rounded-lg"
          >
            News
          </a>
          <a
            href="/predictions"
            class="block text-gray-600 hover:text-gray-900 hover:bg-gray-50 text-sm font-medium px-3 py-2 rounded-lg"
          >
            Predictions
          </a>
          <a
            href={"/mlb/lineups/#{Date.to_iso8601(SportsFanatic.DateHelper.today())}"}
            class="block text-gray-600 hover:text-gray-900 hover:bg-gray-50 text-sm font-medium px-3 py-2 rounded-lg"
          >
            Players
          </a>
          <a
            href="/feeds"
            class="block text-gray-600 hover:text-gray-900 hover:bg-gray-50 text-sm font-medium px-3 py-2 rounded-lg"
          >
            Manage Feeds
          </a>
          <%= if !assigns[:current_user] && SportsFanatic.FeatureFlags.enabled?("subscriptions_enabled") do %>
            <a
              href="/auth/login"
              class="block text-gray-600 hover:text-gray-900 hover:bg-gray-50 text-sm font-medium px-3 py-2 rounded-lg sm:hidden"
            >
              Sign In
            </a>
          <% end %>
        </div>
      </nav>
    </header>

    <main class="flex-1">
      <%= @inner_content %>
    </main>

    <footer class="bg-gray-900 text-gray-400 mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-8">
          <div>
            <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-3">Teams</h3>
            <a href="/mlb/teams" class="block text-sm hover:text-white transition">All Teams</a>
          </div>
          <div>
            <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-3">
              Predictions
            </h3>
            <a href="/predictions" class="block text-sm hover:text-white transition">
              Today's Picks
            </a>
          </div>
          <div>
            <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-3">
              Content
            </h3>
            <a href="/mlb/news" class="block text-sm hover:text-white transition mb-1">
              News
            </a>
            <a href="/predictions" class="block text-sm hover:text-white transition mb-1">
              Predictions
            </a>
            <a
              href={"/mlb/lineups/#{Date.to_iso8601(SportsFanatic.DateHelper.today())}"}
              class="block text-sm hover:text-white transition"
            >
              Players
            </a>
          </div>
          <%= if SportsFanatic.FeatureFlags.enabled?("subscriptions_enabled") do %>
            <div>
              <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-3">
                Premium
              </h3>
              <a href="/subscribe" class="block text-sm hover:text-white transition">Subscribe</a>
            </div>
          <% end %>
        </div>
        <div class="border-t border-gray-800 mt-8 pt-6 text-center text-sm">
          Sports Fan Agent &copy; <%= DateTime.utc_now().year %>. All rights reserved.
        </div>
      </div>
    </footer>
  </body>
</html>
