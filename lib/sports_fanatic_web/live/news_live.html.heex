<SportsFanaticWeb.SEOComponents.breadcrumbs items={[
  %{label: "Home", href: "/"},
  %{label: "Baseball", href: "/mlb/teams"},
  %{label: "News", href: "/mlb/news"},
  %{label: @formatted_date}
]} />

<section class="max-w-4xl mx-auto px-4 py-8">
  <%!-- Chat Interface (feature-flagged) --%>
  <%= if @chat_enabled do %>
    <div
      class="bg-white shadow-sm border border-gray-200 rounded-lg mb-8 -mx-4 px-4 pt-2 pb-2 flex flex-col"
      style="height: calc(100vh - 180px); min-height: 400px;"
    >
      <%!-- Chat header --%>
      <div class="flex items-center justify-between mb-2 flex-shrink-0">
        <h3 class="text-sm font-semibold text-gray-700">News Research Agent</h3>
        <div class="flex items-center gap-2">
          <%= if @agent_running do %>
            <button
              phx-click="cancel_agent"
              class="text-xs text-red-500 hover:text-red-700 font-medium px-2 py-1 rounded border border-red-200 hover:bg-red-50"
            >
              Cancel
            </button>
          <% end %>
          <%= if length(@chat_messages) > 1 do %>
            <button
              phx-click="clear_chat"
              class="text-xs text-gray-500 hover:text-gray-700 font-medium"
            >
              Clear Chat
            </button>
          <% end %>
        </div>
      </div>

      <%!-- Chat messages thread (scrollable, fills available space) --%>
      <div
        class="flex-1 overflow-y-auto min-h-0 space-y-2 px-1 mb-2"
        id="chat-messages"
        phx-hook="ScrollBottom"
      >
        <%= for msg <- @chat_messages do %>
          <%!-- Clickable sample prompts after welcome message --%>
          <%= if msg.id == "welcome" do %>
            <div id="sample-prompts" class="flex flex-wrap gap-2 mt-2 mb-1 justify-start">
              <button
                phx-click="submit_chat"
                phx-value-message="How is Hunter Brown doing?"
                class="text-xs bg-blue-50 text-blue-700 px-3 py-1.5 rounded-full border border-blue-200 hover:bg-blue-100 transition"
              >
                How is Hunter Brown doing?
              </button>
              <button
                phx-click="submit_chat"
                phx-value-message="What's the Mets injury report?"
                class="text-xs bg-blue-50 text-blue-700 px-3 py-1.5 rounded-full border border-blue-200 hover:bg-blue-100 transition"
              >
                Mets injury report
              </button>
              <button
                phx-click="submit_chat"
                phx-value-message="Current HR streaks"
                class="text-xs bg-blue-50 text-blue-700 px-3 py-1.5 rounded-full border border-blue-200 hover:bg-blue-100 transition"
              >
                Current HR streaks
              </button>
              <button
                phx-click="submit_chat"
                phx-value-message="/upload"
                class="text-xs bg-green-50 text-green-700 px-3 py-1.5 rounded-full border border-green-200 hover:bg-green-100 transition"
              >
                Upload roster CSV
              </button>
            </div>
          <% end %>
          <div
            id={"chat-msg-#{msg.id}"}
            class={[
              "flex",
              if(msg.role == "user", do: "justify-end", else: "justify-start")
            ]}
          >
            <div class={[
              "max-w-[80%] rounded-lg px-3 py-2 text-sm",
              cond do
                msg.role == "user" -> "bg-blue-500 text-white"
                msg.role == "progress" -> "bg-gray-100 text-gray-600 italic"
                true -> "bg-gray-50 text-gray-800 border border-gray-200"
              end
            ]}>
              <%= if msg.role == "progress" do %>
                <div class="flex items-center gap-2">
                  <svg
                    class="animate-spin h-3 w-3 text-gray-400"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                  >
                    <circle
                      class="opacity-25"
                      cx="12"
                      cy="12"
                      r="10"
                      stroke="currentColor"
                      stroke-width="4"
                    >
                    </circle>
                    <path
                      class="opacity-75"
                      fill="currentColor"
                      d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
                    >
                    </path>
                  </svg>
                  <span><%= sanitize_chat(msg.content) %></span>
                </div>
              <% else %>
                <%= if msg.role == "assistant" do %>
                  <div class="chat-markdown">
                    <%= render_markdown(msg.content) %>
                  </div>
                <% else %>
                  <%= sanitize_chat(msg.content) %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <%!-- Chat articles from last agent response --%>
      <%= if @chat_articles != [] do %>
        <div class="flex-shrink-0 max-h-32 overflow-y-auto mb-2 space-y-1">
          <%= for article <- @chat_articles do %>
            <div class="bg-white border border-gray-100 rounded px-3 py-2 text-sm">
              <div class="flex items-center gap-2">
                <span class="font-medium text-gray-900 truncate"><%= article["title"] %></span>
                <%= if article["category"] do %>
                  <span class="text-xs px-1.5 py-0.5 rounded bg-gray-100 text-gray-600">
                    <%= article["category"] %>
                  </span>
                <% end %>
              </div>
              <%= if article["ai_summary"] do %>
                <p class="text-xs text-gray-500 mt-1 line-clamp-2">
                  <%= article["ai_summary"] %>
                </p>
              <% end %>
              <%= if article["source_url"] do %>
                <a
                  href={article["source_url"]}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs text-blue-500 hover:text-blue-700 mt-1 inline-block"
                >
                  <%= article["author"] || "Read more" %> &rarr;
                </a>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%!-- File upload area (shown during upload skill) --%>
      <%= if @skill_state && @skill_state.skill == :upload && @skill_state.step == :await_file do %>
        <div class="flex-shrink-0 bg-gray-50 border-2 border-dashed border-gray-300 rounded-lg p-4 mb-2">
          <form id="upload-form" phx-submit="upload_csv" phx-change="validate_upload">
            <.live_file_input
              upload={@uploads.roster_csv}
              class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100"
            />
            <%= for entry <- @uploads.roster_csv.entries do %>
              <div class="flex items-center gap-2 mt-2">
                <span class="text-sm text-gray-700"><%= entry.client_name %></span>
                <span class="text-xs text-gray-500">
                  (<%= div(entry.client_size, 1024) %> KB)
                </span>
                <button
                  type="submit"
                  class="text-xs bg-blue-600 text-white px-3 py-1 rounded-md hover:bg-blue-700"
                >
                  Upload
                </button>
              </div>
              <%= for err <- upload_errors(@uploads.roster_csv, entry) do %>
                <p class="text-sm text-red-600 mt-1"><%= upload_error_message(err) %></p>
              <% end %>
            <% end %>
          </form>
        </div>
      <% end %>

      <%!-- Chat input (pinned to bottom) --%>
      <div class="flex-shrink-0">
        <form phx-submit="submit_chat" class="relative">
          <input
            type="text"
            name="message"
            value={@chat_input}
            placeholder={
              if @skill_state,
                do: skill_placeholder(@skill_state),
                else: "Ask about MLB news, players, or trades... Type /help for commands"
            }
            disabled={@agent_running}
            autofocus
            autocomplete="off"
            class={[
              "w-full rounded-lg border border-gray-300 px-3 py-2 pr-10 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
              if(@agent_running, do: "bg-gray-50 cursor-not-allowed", else: "")
            ]}
          />
          <button
            type="submit"
            disabled={@agent_running}
            class="absolute right-2 top-1/2 -translate-y-1/2 text-blue-500 hover:text-blue-700 disabled:text-gray-300"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z" />
            </svg>
          </button>
        </form>
        <div class="flex items-center justify-between mt-1">
          <span class="text-xs text-gray-400">
            <%= if @agent_running, do: "Searching...", else: "Enter to search" %>
          </span>
          <form id="quick-upload" phx-submit="upload_csv" phx-change="validate_upload" class="flex items-center gap-2">
            <.live_file_input upload={@uploads.roster_csv} class="hidden" />
            <label
              for={@uploads.roster_csv.ref}
              class="text-xs text-gray-500 hover:text-blue-600 cursor-pointer flex items-center gap-1"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
              </svg>
              Upload CSV
            </label>
            <%= for entry <- @uploads.roster_csv.entries do %>
              <span class="text-xs text-gray-600"><%= entry.client_name %></span>
              <button type="submit" class="text-xs bg-blue-600 text-white px-2 py-0.5 rounded hover:bg-blue-700">
                Process
              </button>
            <% end %>
          </form>
        </div>
      </div>
    </div>
  <% else %>
    <%!-- Legacy Sticky Command Input --%>
    <div class="sticky top-0 z-10 bg-white shadow-sm border-b border-gray-200 pb-2 mb-4 -mx-4 px-4 pt-2">
      <form phx-submit="submit_command" class="relative">
        <div class="relative">
          <textarea
            name="input"
            value={@command_input}
            rows="2"
            autofocus
            phx-keydown="submit_command"
            phx-key="Enter"
            placeholder={
              if @current_user,
                do:
                  "Type /settings-apply \"your description\" to create an agent, or search the feed...",
                else: "Search the feed, or log in to use agent commands..."
            }
            class="w-full rounded-lg border border-gray-300 px-3 py-2 pr-8 text-sm resize-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            phx-debounce="300"
          ><%= @command_input %></textarea>
          <%= if @search_query != "" or @command_input != "" do %>
            <button
              type="button"
              phx-click="clear_search"
              class="absolute top-2 right-2 text-gray-400 hover:text-gray-600"
              title="Clear"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                  clip-rule="evenodd"
                />
              </svg>
            </button>
          <% end %>
        </div>
        <div class="flex items-center justify-between mt-1">
          <span class="text-xs text-gray-400">
            Enter to search &middot; Shift+Enter for newline
          </span>
          <div class="flex items-center gap-3">
            <%= if @search_query != "" do %>
              <button
                type="button"
                phx-click="clear_search"
                class="text-xs text-red-500 hover:text-red-700 font-medium"
              >
                Clear Search
              </button>
            <% end %>
            <button type="submit" class="text-xs text-blue-600 hover:text-blue-800 font-medium">
              Submit
            </button>
          </div>
        </div>
      </form>
    </div>
  <% end %>

  <%!-- Feed --%>
  <SportsFanaticWeb.SEOComponents.date_nav
    prev_date={@prev_date}
    next_date={@next_date}
    base_path="/mlb/news"
    link_type={:patch}
  />

  <h1 class="text-3xl font-bold text-gray-900 mb-4">
    MLB News &mdash; <%= @formatted_date %>
  </h1>

  <%!-- Feed selector (only for authenticated users with feeds) --%>
  <%= if @current_user && @user_feeds != [] do %>
    <div class="flex items-center gap-2 mb-4">
      <span class="text-sm text-gray-600 font-medium">Feed:</span>
      <form phx-change="switch_feed" class="flex-1">
        <select
          name="feed_id"
          class="block w-full max-w-xs rounded-md border-gray-300 text-sm focus:ring-blue-500 focus:border-blue-500"
        >
          <option value="">All News</option>
          <%= for feed <- @user_feeds do %>
            <option value={feed.id} selected={@active_feed && @active_feed.id == feed.id}>
              <%= feed.name %> (<%= length(feed.player_ids) %> players)
            </option>
          <% end %>
        </select>
      </form>
    </div>
  <% end %>

  <%!-- Your Feed section (shows matching articles when a feed is active) --%>
  <%= if @feed_articles != [] do %>
    <div class="mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Your Feed</h2>
      <div class="space-y-4">
        <%= for item <- @feed_articles do %>
          <article class="bg-blue-50 rounded-lg shadow-sm border border-blue-100 p-5">
            <div class="flex items-center gap-2 mb-2">
              <.category_badge
                category={item["category"]}
                injury_area={item["injury_area"]}
                injury_grade={item["injury_grade"]}
              />
              <.sentiment_dot sentiment={item["sentiment"]} />
              <%= for tag <- (item["domain_tags"] || []) do %>
                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-indigo-50 text-indigo-700">
                  <%= tag %>
                </span>
              <% end %>
            </div>
            <h3 class="text-lg font-semibold text-gray-900"><%= item["title"] %></h3>
            <%= if item["ai_summary"] && item["ai_summary"] != "" do %>
              <p class="text-gray-600 mt-2 text-sm"><%= item["ai_summary"] %></p>
            <% end %>
            <%= if (item["players"] || []) != [] || (item["teams"] || []) != [] do %>
              <div class="flex flex-wrap gap-2 mt-3">
                <%= for player <- (item["players"] || []) do %>
                  <%= if player["team_slug"] && player["slug"] do %>
                    <a
                      href={"/mlb/players/#{player["team_slug"]}/#{player["slug"]}"}
                      class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-700 hover:bg-blue-200 transition"
                    >
                      <%= player["full_name"] %>
                    </a>
                  <% else %>
                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-700">
                      <%= player["full_name"] %>
                    </span>
                  <% end %>
                <% end %>
                <%= for team <- (item["teams"] || []) do %>
                  <a
                    href={"/mlb/teams/#{team["slug"]}"}
                    class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition"
                  >
                    <span class="font-bold"><%= team["abbreviation"] || team["name"] %></span>
                  </a>
                <% end %>
              </div>
            <% end %>
            <div class="flex gap-3 mt-3 text-xs text-gray-400">
              <%= if item["source_url"] do %>
                <a
                  href={item["source_url"]}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-blue-500 hover:text-blue-700"
                >
                  <%= item["author"] || "Read more" %> &rarr;
                </a>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
      <hr class="my-6 border-gray-200" />
    </div>
  <% end %>

  <%!-- Feed search filter --%>
  <form phx-submit="submit_command" class="mb-4">
    <div class="relative">
      <input
        type="text"
        name="input"
        value={@command_input}
        placeholder="Filter news feed..."
        autocomplete="off"
        phx-debounce="300"
        class="w-full rounded-lg border border-gray-300 px-3 py-2 pr-8 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
      />
      <%= if @search_query != "" or @command_input != "" do %>
        <button
          type="button"
          phx-click="clear_search"
          class="absolute top-2 right-2 text-gray-400 hover:text-gray-600"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
              clip-rule="evenodd"
            />
          </svg>
        </button>
      <% end %>
    </div>
  </form>

  <%!-- Search indicator --%>
  <%= if @search_query != "" do %>
    <div class="mb-4 bg-blue-50 border border-blue-200 rounded-lg px-4 py-2 flex items-center justify-between">
      <span class="text-sm text-blue-800">
        Showing <strong><%= length(@filtered_feed || []) %></strong>
        results for "<strong><%= @search_query %></strong>"
      </span>
      <button
        phx-click="clear_search"
        class="inline-flex items-center gap-1 px-3 py-1 bg-white border border-blue-300 rounded-md text-sm text-blue-700 hover:bg-blue-100 font-medium"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
            clip-rule="evenodd"
          />
        </svg>
        Clear Search
      </button>
    </div>
  <% end %>

  <% display_feed = @filtered_feed || @feed %>

  <%= if Enum.empty?(display_feed) do %>
    <p class="text-gray-500">
      <%= if @search_query != "",
        do: "No articles match your search.",
        else: "No news for this date." %>
    </p>
  <% else %>
    <div class="space-y-4" id="news-feed" phx-update="replace">
      <%= for item <- display_feed do %>
        <article
          id={"news-#{item["id"]}"}
          class="bg-white rounded-lg shadow-sm border border-gray-100 p-5"
        >
          <div class="flex items-center gap-2 mb-2">
            <.category_badge
              category={item["category"]}
              injury_area={item["injury_area"]}
              injury_grade={item["injury_grade"]}
            />
            <.sentiment_dot sentiment={item["sentiment"]} />

            <%!-- Domain tags --%>
            <%= for tag <- (item["domain_tags"] || []) do %>
              <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-indigo-50 text-indigo-700">
                <%= tag %>
              </span>
            <% end %>
          </div>

          <h2 class="text-lg font-semibold text-gray-900"><%= item["title"] %></h2>

          <%= if item["ai_summary"] && item["ai_summary"] != "" do %>
            <p class="text-gray-600 mt-2 text-sm"><%= item["ai_summary"] %></p>
          <% end %>

          <%= if item["body"] && item["body"] != "" do %>
            <p class="text-gray-500 mt-2 text-sm"><%= item["body"] %></p>
          <% else %>
            <%= if item["summary"] && item["summary"] != "" do %>
              <p class="text-gray-500 mt-2 text-sm"><%= item["summary"] %></p>
            <% end %>
          <% end %>

          <%!-- Entity data: players and teams --%>
          <%= if (item["players"] || []) != [] || (item["teams"] || []) != [] do %>
            <div class="flex flex-wrap gap-2 mt-3">
              <%!-- Player links --%>
              <%= for player <- (item["players"] || []) do %>
                <%= if player["team_slug"] && player["slug"] do %>
                  <a
                    href={"/mlb/players/#{player["team_slug"]}/#{player["slug"]}"}
                    class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-50 text-blue-700 hover:bg-blue-100 transition"
                  >
                    <%= player["full_name"] %>
                  </a>
                <% else %>
                  <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-50 text-blue-700">
                    <%= player["full_name"] %>
                  </span>
                <% end %>
              <% end %>

              <%!-- Team badges with abbreviation and league --%>
              <%= for team <- (item["teams"] || []) do %>
                <a
                  href={"/mlb/teams/#{team["slug"]}"}
                  class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition"
                >
                  <span class="font-bold"><%= team["abbreviation"] || team["name"] %></span>
                  <%= if team["league"] do %>
                    <span class={[
                      "px-1 py-0.5 rounded text-xs font-medium",
                      if(team["league"] == "AL",
                        do: "bg-red-100 text-red-600",
                        else: "bg-blue-100 text-blue-600"
                      )
                    ]}>
                      <%= team["league"] %>
                    </span>
                  <% end %>
                </a>
              <% end %>
            </div>
          <% end %>

          <div class="flex gap-3 mt-3 text-xs text-gray-400">
            <%= if item["source_url"] do %>
              <a
                href={item["source_url"]}
                target="_blank"
                rel="noopener noreferrer"
                class="text-blue-500 hover:text-blue-700"
              >
                <%= item["author"] || "Read more" %> &rarr;
              </a>
            <% else %>
              <%= if item["author"] do %>
                <span><%= item["author"] %></span>
              <% end %>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  <% end %>

  <SportsFanaticWeb.SEOComponents.date_nav
    prev_date={@prev_date}
    next_date={@next_date}
    base_path="/mlb/news"
    link_type={:patch}
  />
</section>
