<SportsFanaticWeb.SEOComponents.breadcrumbs items={[
  %{label: "Home", href: "/"},
  %{label: "Players", href: "/mlb/players"},
  %{label: @team.name, href: "/mlb/teams/#{@team.slug}"},
  %{label: "#{@player.full_name} Scouting Report"}
]} />

<article class="max-w-4xl mx-auto px-4 py-8">
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Scouting Report: <%= @player.full_name %></h1>
    <p class="text-lg text-gray-600">
      <a href={"/mlb/teams/#{@team.slug}"} class="text-blue-600 hover:text-blue-800">
        <%= @team.name %>
      </a>
      | <%= @player.position %>
    </p>
  </header>

  <%= if @report do %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-8">
      <div class="flex items-center gap-4 mb-4">
        <div class="text-center">
          <span class="text-3xl font-bold text-blue-600"><%= @report.overall_grade %></span>
          <p class="text-xs text-gray-500">Overall</p>
        </div>
        <%= if @report.injury_risk && @report.injury_risk != "healthy" do %>
          <span class="px-3 py-1 bg-red-100 text-red-800 rounded-full text-sm font-medium">
            <%= @report.injury_risk %>
          </span>
        <% end %>
      </div>

      <h2 class="text-lg font-semibold text-gray-900 mb-2">Summary</h2>
      <p class="text-gray-700 leading-relaxed mb-6"><%= @report.summary %></p>

      <%= if @report.strengths && length(@report.strengths) > 0 do %>
        <div class="mb-4">
          <h3 class="font-medium text-green-700 mb-2">Strengths</h3>
          <ul class="list-disc list-inside text-gray-700 text-sm space-y-1">
            <%= for s <- Enum.take(@report.strengths, 2) do %>
              <li><%= s %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="bg-gradient-to-r from-gray-50 to-blue-50 rounded-lg p-4 mt-6 border border-blue-100">
        <p class="text-gray-700 text-sm mb-3">
          This is a preview of the full scouting report. Subscribe for complete analysis
          including hit/HR probabilities, all strengths/weaknesses, injury details, and confidence modifiers.
        </p>
        <a
          href="/subscribe"
          class="inline-block bg-blue-600 text-white font-semibold px-6 py-2 rounded-lg hover:bg-blue-700 transition text-sm"
        >
          Unlock Full Report
        </a>
      </div>
    </div>
  <% else %>
    <div class="bg-gray-50 rounded-lg p-8 text-center">
      <p class="text-gray-500 mb-4">
        No scouting report available yet for <%= @player.full_name %>.
      </p>
      <p class="text-sm text-gray-400">
        Reports are generated daily for players in confirmed lineups.
      </p>
    </div>
  <% end %>

  <SportsFanaticWeb.SEOComponents.subscribe_cta return_to={"/mlb/scouting/#{@team.slug}/#{@player.slug}"} />

  <div class="mt-6">
    <a
      href={"/mlb/players/#{@team.slug}/#{@player.slug}"}
      class="text-blue-600 hover:text-blue-800"
    >
      &larr; Back to player profile
    </a>
  </div>
</article>
