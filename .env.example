# Phoenix
SECRET_KEY_BASE=generate_with_mix_phx_gen_secret
PHX_HOST=localhost

# Database
DATABASE_URL=ecto://postgres:postgres@localhost:5432/sports_fanatic

# Cache
VALKEY_URL=redis://localhost:6379

# Python Bridge
PYTHON_BRIDGE_URL=http://localhost:8000

# External APIs
FANTASY_NERDS_API_KEY=your_fantasy_nerds_key
ANTHROPIC_API_KEY=your_anthropic_key
EXA_API_KEY=your_exa_key

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_MONTHLY=price_monthly_id
STRIPE_PRICE_YEARLY=price_yearly_id

# Joshua admin gate (auto-generate with: python3 -c "import secrets,string; c=string.ascii_letters+string.digits; print('sf_admin_'+''.join(secrets.choice(c) for _ in range(24)))")
JOSHUA_USERNAME=sf_admin_CHANGE_ME_GENERATE_RANDOM
JOSHUA_PASSWORD=CHANGE_ME_GENERATE_64_CHAR_RANDOM_STRING

# AWS / S3 (news article storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
NEWS_S3_BUCKET=sports-fanatic-news
NEWS_S3_ENABLED=false

# X (Twitter) agent
# X_CLIENT_ID and X_CLIENT_SECRET come from the X Developer Portal OAuth2 app.
# X_TOKEN_ENCRYPTION_KEY must be 32 bytes base64-encoded (openssl rand -base64 32).
# X_DAILY_CAP_MILLS is the daily spend cap in millicents (default 5000 = $0.05).
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret
X_REDIRECT_URI=https://yourdomain.com/admin/x/oauth/callback
X_TOKEN_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32
X_DAILY_CAP_MILLS=5000
X_ACCOUNT_HANDLE=sportsfanatic_mlb
