<SportsFanaticWeb.SEOComponents.breadcrumbs items={[
  %{label: "Home", href: "/"},
  %{label: "Baseball", href: "/mlb/teams"},
  %{label: "Lineups", href: "/mlb/lineups/#{Date.utc_today() |> Date.to_iso8601()}"},
  %{label: Calendar.strftime(@date, "%B %d, %Y")}
]} />

<section class="max-w-6xl mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-gray-900 mb-6">
    MLB Lineups - <%= Calendar.strftime(@date, "%B %d, %Y") %>
  </h1>

  <%= if Enum.empty?(@games) do %>
    <p class="text-gray-500">No games scheduled for this date.</p>
  <% else %>
    <div class="space-y-6">
      <%= for game <- @games do %>
        <% away_team = @teams_by_mlb_id[game.away_mlb_id]
        home_team = @teams_by_mlb_id[game.home_mlb_id]
        away_abbr = if away_team, do: away_team.abbreviation, else: nil
        home_abbr = if home_team, do: home_team.abbreviation, else: nil
        away_lineups = if away_abbr, do: Map.get(@lineups_by_team_code, away_abbr, []), else: []
        home_lineups = if home_abbr, do: Map.get(@lineups_by_team_code, home_abbr, []), else: [] %>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <div class="flex justify-between items-center mb-4">
            <div>
              <h2 class="text-xl font-semibold text-gray-900">
                <.team_link team={away_team} name={game.away_name} /> @
                <.team_link team={home_team} name={game.home_name} />
              </h2>
              <p class="text-sm text-gray-500"><%= game.venue_name %></p>
            </div>
            <div class="text-right text-sm text-gray-500">
              <%= if game.game_datetime do %>
                <p><%= Calendar.strftime(game.game_datetime, "%I:%M %p ET") %></p>
              <% end %>
              <%= if game.away_probable_pitcher || game.home_probable_pitcher do %>
                <p>
                  <%= game.away_probable_pitcher || "TBD" %> vs <%= game.home_probable_pitcher ||
                    "TBD" %>
                </p>
              <% end %>
            </div>
          </div>

          <%= if Enum.empty?(away_lineups) and Enum.empty?(home_lineups) do %>
            <p class="text-gray-400 italic text-sm">Lineups not yet available</p>
          <% else %>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <h3 class="font-medium text-gray-700 mb-2">
                  <.team_link team={away_team} name={game.away_name} />
                </h3>
                <%= if Enum.empty?(away_lineups) do %>
                  <p class="text-gray-400 italic text-sm">Lineup not yet available</p>
                <% else %>
                  <ol class="text-sm space-y-1">
                    <%= for lineup <- Enum.sort_by(away_lineups, & &1.batting_order) do %>
                      <li class="text-gray-600">
                        <span class="text-gray-400 mr-1"><%= lineup.batting_order %>.</span>
                        <.player_link lineup={lineup} />
                        <span class="text-gray-400 ml-1"><%= lineup.position %></span>
                      </li>
                    <% end %>
                  </ol>
                <% end %>
              </div>
              <div>
                <h3 class="font-medium text-gray-700 mb-2">
                  <.team_link team={home_team} name={game.home_name} />
                </h3>
                <%= if Enum.empty?(home_lineups) do %>
                  <p class="text-gray-400 italic text-sm">Lineup not yet available</p>
                <% else %>
                  <ol class="text-sm space-y-1">
                    <%= for lineup <- Enum.sort_by(home_lineups, & &1.batting_order) do %>
                      <li class="text-gray-600">
                        <span class="text-gray-400 mr-1"><%= lineup.batting_order %>.</span>
                        <.player_link lineup={lineup} />
                        <span class="text-gray-400 ml-1"><%= lineup.position %></span>
                      </li>
                    <% end %>
                  </ol>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <nav class="mt-8 flex justify-between" aria-label="Date navigation">
    <a
      href={"/mlb/lineups/#{Date.add(@date, -1) |> Date.to_iso8601()}"}
      class="text-blue-600 hover:text-blue-800"
    >
      &larr; Previous Day
    </a>
    <a
      href={"/mlb/lineups/#{Date.add(@date, 1) |> Date.to_iso8601()}"}
      class="text-blue-600 hover:text-blue-800"
    >
      Next Day &rarr;
    </a>
  </nav>
</section>
