<SportsFanaticWeb.SEOComponents.breadcrumbs items={[
  %{label: "Home", href: "/"},
  %{label: "Players", href: "/mlb/players"},
  %{label: @team.name, href: "/mlb/teams/#{@team.slug}"},
  %{label: @player.full_name}
]} />

<%= if assigns[:json_ld] do %>
  <SportsFanaticWeb.SEOComponents.json_ld data={@json_ld} />
<% end %>

<article class="max-w-6xl mx-auto px-4 py-8">
  <header class="flex items-start gap-6 mb-8">
    <%= if @player.headshot_url do %>
      <img
        src={@player.headshot_url}
        alt={@player.full_name}
        class="w-24 h-24 rounded-full object-cover shadow-lg"
      />
    <% else %>
      <div class="w-24 h-24 rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white text-2xl font-bold shadow-lg">
        <%= String.first(@player.first_name || "") %><%= String.first(@player.last_name || "") %>
      </div>
    <% end %>
    <div>
      <h1 class="text-3xl font-bold text-gray-900"><%= @player.full_name %></h1>
      <p class="text-lg text-gray-600">
        <a href={"/mlb/teams/#{@team.slug}"} class="text-blue-600 hover:text-blue-800">
          <%= @team.name %>
        </a>
        <span class="mx-2">|</span>
        <span><%= @player.position %></span>
        <%= if @player.jersey_number do %>
          <span class="mx-2">|</span>
          <span>#<%= @player.jersey_number %></span>
        <% end %>
      </p>
      <div class="flex gap-4 text-sm text-gray-500 mt-2">
        <%= if @player.bats do %>
          <span>Bats: <%= @player.bats %></span>
        <% end %>
        <%= if @player.throws do %>
          <span>Throws: <%= @player.throws %></span>
        <% end %>
        <%= if @player.height do %>
          <span><%= @player.height %></span>
        <% end %>
        <%= if @player.weight do %>
          <span><%= @player.weight %> lbs</span>
        <% end %>
      </div>
    </div>
  </header>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2">
      <%!-- Full Scouting Report (above Player Overview) --%>
      <%= if @scouting do %>
        <%= if !SportsFanatic.FeatureFlags.enabled?("subscriptions_enabled") do %>
          <%!-- Subscriptions disabled: show full report to everyone --%>
          <section class="mb-8">
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
              <div class="flex items-center gap-4 mb-4">
                <span class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-blue-100 text-blue-700 text-xl font-bold">
                  <%= @scouting.overall_grade %>
                </span>
                <div>
                  <h2 class="text-xl font-semibold text-gray-900">Scouting Report</h2>
                  <p class="text-sm text-gray-500">
                    Updated <%= Calendar.strftime(@scouting.report_date, "%B %d, %Y") %>
                  </p>
                </div>
              </div>

              <p class="text-gray-700 leading-relaxed mb-4"><%= @scouting.summary %></p>

              <%= if @scouting.strengths && length(@scouting.strengths) > 0 do %>
                <div class="mb-4">
                  <h3 class="text-sm font-semibold text-green-700 uppercase tracking-wide mb-2">
                    Strengths
                  </h3>
                  <ul class="space-y-1">
                    <%= for strength <- @scouting.strengths do %>
                      <li class="flex items-start gap-2 text-sm text-gray-700">
                        <span class="text-green-500 mt-0.5">+</span>
                        <span><%= strength %></span>
                      </li>
                    <% end %>
                  </ul>
                </div>
              <% end %>

              <%= if @scouting.weaknesses && length(@scouting.weaknesses) > 0 do %>
                <div class="mb-4">
                  <h3 class="text-sm font-semibold text-red-700 uppercase tracking-wide mb-2">
                    Weaknesses
                  </h3>
                  <ul class="space-y-1">
                    <%= for weakness <- @scouting.weaknesses do %>
                      <li class="flex items-start gap-2 text-sm text-gray-700">
                        <span class="text-red-500 mt-0.5">-</span>
                        <span><%= weakness %></span>
                      </li>
                    <% end %>
                  </ul>
                </div>
              <% end %>

              <%= if @scouting.injury_risk && @scouting.injury_risk != "healthy" do %>
                <div class="mb-4 p-3 bg-yellow-50 border border-yellow-200 rounded-lg">
                  <p class="text-sm text-yellow-800">
                    <span class="font-semibold">Injury Status:</span>
                    <%= @scouting.injury_risk %>
                    <%= if @scouting.injury_detail do %>
                      -- <%= @scouting.injury_detail %>
                    <% end %>
                  </p>
                </div>
              <% end %>

              <div class="flex gap-6 pt-4 border-t border-gray-100">
                <%= if @scouting.hit_probability do %>
                  <div class="text-center">
                    <p class="text-2xl font-bold text-blue-600">
                      <%= Float.round(@scouting.hit_probability * 100, 1) %>%
                    </p>
                    <p class="text-xs text-gray-500">Hit Probability</p>
                  </div>
                <% end %>
                <%= if @scouting.hr_probability do %>
                  <div class="text-center">
                    <p class="text-2xl font-bold text-purple-600">
                      <%= Float.round(@scouting.hr_probability * 100, 1) %>%
                    </p>
                    <p class="text-xs text-gray-500">HR Probability</p>
                  </div>
                <% end %>
                <div class="text-center">
                  <p class="text-2xl font-bold text-gray-600">
                    <%= @scouting.sources_count || 0 %>
                  </p>
                  <p class="text-xs text-gray-500">Sources Analyzed</p>
                </div>
              </div>
            </div>
          </section>
        <% else %>
          <%!-- Subscriptions enabled: show preview + CTA --%>
          <section class="mb-8">
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
              <div class="flex items-center gap-4 mb-4">
                <span class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-blue-100 text-blue-700 text-xl font-bold">
                  <%= @scouting.overall_grade %>
                </span>
                <div>
                  <h2 class="text-xl font-semibold text-gray-900">Scouting Report</h2>
                  <p class="text-sm text-gray-500">
                    Updated <%= Calendar.strftime(@scouting.report_date, "%B %d, %Y") %>
                  </p>
                </div>
              </div>

              <p class="text-gray-700 leading-relaxed mb-4"><%= @scouting.summary %></p>

              <div class="relative">
                <div class="absolute inset-0 bg-gradient-to-b from-transparent to-white z-10">
                </div>
                <div class="blur-sm opacity-50 pointer-events-none">
                  <p class="text-sm text-gray-600">
                    Detailed strengths, weaknesses, injury analysis, and probability breakdowns available with a premium subscription.
                  </p>
                </div>
              </div>

              <SportsFanaticWeb.SEOComponents.subscribe_cta return_to={"/mlb/players/#{@team.slug}/#{@player.slug}"} />
            </div>
          </section>
        <% end %>
      <% end %>

      <%= if @scouting_pending do %>
        <section class="mb-8">
          <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 text-sm text-amber-800">
            <div class="flex items-center gap-3">
              <svg class="animate-spin h-5 w-5 text-amber-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
              </svg>
              <div>
                <p class="font-semibold">Generating Scouting Report</p>
                <p class="mt-0.5">
                  Creating a fresh scouting report for <%= @player.full_name %>. This page will refresh automatically when ready.
                </p>
              </div>
            </div>
          </div>
          <%!-- Auto-refresh every 10 seconds to check if report is ready --%>
          <meta http-equiv="refresh" content="10" />
        </section>
      <% end %>

      <%= if @player.bio do %>
        <section class="mb-8">
          <h2 class="text-xl font-semibold text-gray-900 mb-3">About</h2>
          <p class="text-gray-700 leading-relaxed"><%= @player.bio %></p>
        </section>
      <% end %>

      <section class="mb-8">
        <h2 class="text-xl font-semibold text-gray-900 mb-3">Player Overview</h2>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <div class="grid grid-cols-2 md:grid-cols-3 gap-4 text-sm">
            <div>
              <span class="text-gray-500 block">Position</span>
              <p class="font-medium text-gray-900"><%= @player.position || "N/A" %></p>
            </div>
            <div>
              <span class="text-gray-500 block">Team</span>
              <p class="font-medium text-gray-900"><%= @team.name %></p>
            </div>
            <%= if @player.bats do %>
              <div>
                <span class="text-gray-500 block">Bats</span>
                <p class="font-medium text-gray-900"><%= @player.bats %></p>
              </div>
            <% end %>
            <%= if @player.throws do %>
              <div>
                <span class="text-gray-500 block">Throws</span>
                <p class="font-medium text-gray-900"><%= @player.throws %></p>
              </div>
            <% end %>
            <%= if @player.height do %>
              <div>
                <span class="text-gray-500 block">Height</span>
                <p class="font-medium text-gray-900"><%= @player.height %></p>
              </div>
            <% end %>
            <%= if @player.weight do %>
              <div>
                <span class="text-gray-500 block">Weight</span>
                <p class="font-medium text-gray-900"><%= @player.weight %> lbs</p>
              </div>
            <% end %>
            <%= if @player.birth_date do %>
              <div>
                <span class="text-gray-500 block">Born</span>
                <p class="font-medium text-gray-900">
                  <%= Calendar.strftime(@player.birth_date, "%B %d, %Y") %>
                </p>
              </div>
            <% end %>
            <%= if @player.jersey_number do %>
              <div>
                <span class="text-gray-500 block">Jersey</span>
                <p class="font-medium text-gray-900">#<%= @player.jersey_number %></p>
              </div>
            <% end %>
          </div>
        </div>
      </section>

      <%= if @news && length(@news) > 0 do %>
        <section>
          <h2 class="text-xl font-semibold text-gray-900 mb-3">Recent News</h2>
          <div class="space-y-3">
            <%= for item <- @news do %>
              <a
                href={"/mlb/news/#{Date.to_iso8601(item.published_date)}/#{item.slug}"}
                class="block bg-white rounded-lg shadow-sm border border-gray-100 p-4 hover:border-blue-300 transition"
              >
                <h3 class="font-medium text-gray-900"><%= item.title %></h3>
                <p class="text-sm text-gray-500 mt-1">
                  <%= Calendar.strftime(item.published_date, "%b %d, %Y") %>
                </p>
              </a>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>

    <aside>
      <%= if @hit_pick || @hr_pick do %>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
          <h3 class="font-semibold text-gray-900 mb-4">Today's Predictions</h3>
          <%= if @hit_pick do %>
            <div class="mb-4">
              <p class="text-sm text-gray-500">Hit Prediction</p>
              <div class="flex items-center gap-2">
                <span class={"text-lg font-bold #{if @hit_pick.prediction == "Hit", do: "text-green-600", else: "text-red-600"}"}>
                  <%= @hit_pick.prediction %>
                </span>
                <span class="text-sm text-gray-500">
                  <%= Float.round(@hit_pick.confidence * 100, 1) %>%
                </span>
              </div>
              <p class="text-xs text-gray-400">vs <%= @hit_pick.vs_team %></p>
            </div>
          <% end %>
          <%= if @hr_pick do %>
            <div>
              <p class="text-sm text-gray-500">HR Probability</p>
              <div class="flex items-center gap-2">
                <span class="text-lg font-bold text-purple-600">
                  <%= Float.round(@hr_pick.hr_probability * 100, 1) %>%
                </span>
                <span class={"px-2 py-0.5 text-xs rounded-full font-medium #{case @hr_pick.confidence_tier do
                  "A" -> "bg-green-100 text-green-800"
                  "B" -> "bg-yellow-100 text-yellow-800"
                  _ -> "bg-gray-100 text-gray-800"
                end}"}>
                  <%= @hr_pick.confidence_tier %> tier
                </span>
              </div>
              <p class="text-xs text-gray-400">vs <%= @hr_pick.vs_team %></p>
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="bg-gray-50 rounded-lg p-6">
        <h3 class="font-semibold text-gray-900 mb-3">Quick Links</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href={"/mlb/scouting/#{@team.slug}/#{@player.slug}"}
              class="text-blue-600 hover:text-blue-800"
            >
              Full Scouting Report
            </a>
          </li>
          <%= for category <- @scouting_categories do %>
            <li>
              <a
                href={"/mlb/players/#{@team.slug}/#{@player.slug}/sources/#{category}"}
                class="text-blue-600 hover:text-blue-800"
              >
                <%= SportsFanaticWeb.PlayerHTML.category_label(category) %>
              </a>
            </li>
          <% end %>
          <li>
            <a href={"/mlb/teams/#{@team.slug}"} class="text-blue-600 hover:text-blue-800">
              <%= @team.name %> Team Page
            </a>
          </li>
          <li>
            <a
              href={"/mlb/lineups/#{Date.to_iso8601(SportsFanatic.DateHelper.today())}"}
              class="text-blue-600 hover:text-blue-800"
            >
              Today's Lineups
            </a>
          </li>
        </ul>
      </div>
    </aside>
  </div>
</article>
