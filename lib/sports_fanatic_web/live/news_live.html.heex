<SportsFanaticWeb.SEOComponents.breadcrumbs items={[
  %{label: "Home", href: "/"},
  %{label: "Baseball", href: "/mlb/teams"},
  %{label: "News", href: "/mlb/news"},
  %{label: @formatted_date}
]} />

<section class="max-w-4xl mx-auto px-4 py-8">
  <%!-- Sticky Command Input --%>
  <div class="sticky top-0 z-10 bg-white shadow-sm border-b border-gray-200 pb-2 mb-4 -mx-4 px-4 pt-2">
    <form phx-submit="submit_command" class="relative">
      <div class="relative">
        <textarea
          name="input"
          value={@command_input}
          rows="2"
          autofocus
          phx-keydown="submit_command"
          phx-key="Enter"
          placeholder={if @current_user, do: "Type /settings-apply \"your description\" to create an agent, or search the feed...", else: "Search the feed, or log in to use agent commands..."}
          class="w-full rounded-lg border border-gray-300 px-3 py-2 pr-8 text-sm resize-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          phx-debounce="300"
        ><%= @command_input %></textarea>
        <%= if @search_query != "" or @command_input != "" do %>
          <button
            type="button"
            phx-click="clear_search"
            class="absolute top-2 right-2 text-gray-400 hover:text-gray-600"
            title="Clear"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
            </svg>
          </button>
        <% end %>
      </div>
      <div class="flex items-center justify-between mt-1">
        <span class="text-xs text-gray-400">
          Enter to search &middot; Shift+Enter for newline
        </span>
        <div class="flex items-center gap-3">
          <%= if @search_query != "" do %>
            <button
              type="button"
              phx-click="clear_search"
              class="text-xs text-red-500 hover:text-red-700 font-medium"
            >
              Clear Search
            </button>
          <% end %>
          <button type="submit" class="text-xs text-blue-600 hover:text-blue-800 font-medium">
            Submit
          </button>
        </div>
      </div>
    </form>
  </div>

  <%!-- Feed --%>
    <SportsFanaticWeb.SEOComponents.date_nav
      prev_date={@prev_date}
      next_date={@next_date}
      base_path="/mlb/news"
      link_type={:patch}
    />

    <h1 class="text-3xl font-bold text-gray-900 mb-6">
      MLB News &mdash; <%= @formatted_date %>
    </h1>

    <%!-- Search indicator --%>
    <%= if @search_query != "" do %>
      <div class="mb-4 bg-blue-50 border border-blue-200 rounded-lg px-4 py-2 flex items-center justify-between">
        <span class="text-sm text-blue-800">
          Showing <strong><%= length(@filtered_feed || []) %></strong> results for "<strong><%= @search_query %></strong>"
        </span>
        <button
          phx-click="clear_search"
          class="inline-flex items-center gap-1 px-3 py-1 bg-white border border-blue-300 rounded-md text-sm text-blue-700 hover:bg-blue-100 font-medium"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
          Clear Search
        </button>
      </div>
    <% end %>

    <% display_feed = @filtered_feed || @feed %>

    <%= if Enum.empty?(display_feed) do %>
      <p class="text-gray-500">
        <%= if @search_query != "",
          do: "No articles match your search.",
          else: "No news for this date." %>
      </p>
    <% else %>
      <div class="space-y-4" id="news-feed" phx-update="replace">
        <%= for item <- display_feed do %>
          <article
            id={"news-#{item["id"]}"}
            class="bg-white rounded-lg shadow-sm border border-gray-100 p-5"
          >
            <div class="flex items-center gap-2 mb-2">
              <.category_badge
                category={item["category"]}
                injury_area={item["injury_area"]}
                injury_grade={item["injury_grade"]}
              />
              <.sentiment_dot sentiment={item["sentiment"]} />

              <%!-- Domain tags --%>
              <%= for tag <- (item["domain_tags"] || []) do %>
                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-indigo-50 text-indigo-700">
                  <%= tag %>
                </span>
              <% end %>
            </div>

            <h2 class="text-lg font-semibold text-gray-900"><%= item["title"] %></h2>

            <%= if item["ai_summary"] && item["ai_summary"] != "" do %>
              <p class="text-gray-600 mt-2 text-sm"><%= item["ai_summary"] %></p>
            <% end %>

            <%= if item["body"] && item["body"] != "" do %>
              <p class="text-gray-500 mt-2 text-sm"><%= item["body"] %></p>
            <% else %>
              <%= if item["summary"] && item["summary"] != "" do %>
                <p class="text-gray-500 mt-2 text-sm"><%= item["summary"] %></p>
              <% end %>
            <% end %>

            <%!-- Entity data: players and teams --%>
            <%= if (item["players"] || []) != [] || (item["teams"] || []) != [] do %>
              <div class="flex flex-wrap gap-2 mt-3">
                <%!-- Player links --%>
                <%= for player <- (item["players"] || []) do %>
                  <%= if player["team_slug"] && player["slug"] do %>
                    <a
                      href={"/mlb/players/#{player["team_slug"]}/#{player["slug"]}"}
                      class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-50 text-blue-700 hover:bg-blue-100 transition"
                    >
                      <%= player["full_name"] %>
                    </a>
                  <% else %>
                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-50 text-blue-700">
                      <%= player["full_name"] %>
                    </span>
                  <% end %>
                <% end %>

                <%!-- Team badges with abbreviation and league --%>
                <%= for team <- (item["teams"] || []) do %>
                  <a
                    href={"/mlb/teams/#{team["slug"]}"}
                    class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition"
                  >
                    <span class="font-bold"><%= team["abbreviation"] || team["name"] %></span>
                    <%= if team["league"] do %>
                      <span class={[
                        "px-1 py-0.5 rounded text-xs font-medium",
                        if(team["league"] == "AL",
                          do: "bg-red-100 text-red-600",
                          else: "bg-blue-100 text-blue-600"
                        )
                      ]}>
                        <%= team["league"] %>
                      </span>
                    <% end %>
                  </a>
                <% end %>
              </div>
            <% end %>

            <div class="flex gap-3 mt-3 text-xs text-gray-400">
              <%= if item["source_url"] do %>
                <a
                  href={item["source_url"]}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-blue-500 hover:text-blue-700"
                >
                  <%= item["author"] || "Read more" %> &rarr;
                </a>
              <% else %>
                <%= if item["author"] do %>
                  <span><%= item["author"] %></span>
                <% end %>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    <% end %>

    <SportsFanaticWeb.SEOComponents.date_nav
      prev_date={@prev_date}
      next_date={@next_date}
      base_path="/mlb/news"
      link_type={:patch}
    />

</section>
