<SportsFanaticWeb.SEOComponents.breadcrumbs items={[
  %{label: "Home", href: "/"},
  %{label: "Baseball", href: "/mlb/teams"},
  %{
    label: "Players",
    href: "/mlb/lineups/#{SportsFanatic.DateHelper.today() |> Date.to_iso8601()}"
  },
  %{label: Calendar.strftime(@date, "%B %d, %Y")}
]} />

<section class="max-w-6xl mx-auto px-4 py-8">
  <SportsFanaticWeb.SEOComponents.date_nav
    prev_date={@prev_date}
    next_date={@next_date}
    base_path="/mlb/lineups"
  />

  <h1 class="text-3xl font-bold text-gray-900 mb-2">
    MLB Players - <%= Calendar.strftime(@date, "%B %d, %Y") %>
  </h1>
  <p class="text-gray-600 mb-6">
    Browse today's lineups, active rosters, and inactive players. Click any
    card for the latest scouting or player page.
  </p>

  <%!-- Search dropdown — embedded roster JSON, vanilla JS substring filter --%>
  <div id="player-search" class="relative mb-10">
    <label for="player-search-input" class="sr-only">Search MLB players</label>
    <input
      type="search"
      id="player-search-input"
      placeholder={"Search any MLB player… (#{@roster_count} on file)"}
      autocomplete="off"
      autofocus
      aria-controls="player-search-results"
      aria-expanded="false"
      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
    />
    <ul
      id="player-search-results"
      role="listbox"
      class="hidden absolute z-20 w-full mt-1 bg-white border border-gray-200 rounded-lg shadow-lg max-h-96 overflow-y-auto"
    >
    </ul>
    <noscript>
      <p class="text-sm text-gray-500 mt-2">
        JavaScript is disabled. Browse the player groups below or visit <a
          href="/mlb/players"
          class="text-blue-600 hover:underline"
        >/mlb/players</a>.
      </p>
    </noscript>
  </div>

  <script type="application/json" id="players-roster-data">
    <%= raw(@roster_json) %>
  </script>

  <%!-- Group 1 — In the lineup today --%>
  <section class="mb-12" aria-labelledby="group-in-lineup">
    <h2 id="group-in-lineup" class="text-2xl font-bold text-gray-900 mb-1">
      In the lineup today
    </h2>
    <p class="text-sm text-gray-500 mb-4">
      <%= length(@groups.lineup) %> players
    </p>
    <%= if @groups.lineup == [] do %>
      <p class="text-gray-500 italic">No players in the lineup today.</p>
    <% else %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <%= for row <- @groups.lineup do %>
          <% card = Map.get(@cards, row.player.id, %{}) %>
          <.player_card
            player={row.player}
            team={row.team}
            link_target={Map.get(card, :link_target, "/mlb/players")}
            injury_badge={Map.get(card, :injury_badge, :grey)}
            position_override={row.position}
            batting_order={row.batting_order}
            variant={:lineup}
          />
        <% end %>
      </div>
    <% end %>
  </section>

  <%!-- Group 2 — Active not in lineup --%>
  <section class="mb-12" aria-labelledby="group-active">
    <h2 id="group-active" class="text-2xl font-bold text-gray-900 mb-1">
      Active players not in the lineup
    </h2>
    <p class="text-sm text-gray-500 mb-4">
      <%= length(@groups.active_not_in_lineup) %> players
    </p>
    <%= if @groups.active_not_in_lineup == [] do %>
      <p class="text-gray-500 italic">
        All active players are in today's lineup.
      </p>
    <% else %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <%= for row <- @groups.active_not_in_lineup do %>
          <% card = Map.get(@cards, row.player.id, %{}) %>
          <.player_card
            player={row.player}
            team={row.team}
            link_target={Map.get(card, :link_target, "/mlb/players")}
            injury_badge={Map.get(card, :injury_badge, :grey)}
          />
        <% end %>
      </div>
    <% end %>
  </section>

  <%!-- Group 3 — Inactive --%>
  <section class="mb-12" aria-labelledby="group-inactive">
    <h2 id="group-inactive" class="text-2xl font-bold text-gray-900 mb-1">
      Inactive players
    </h2>
    <p class="text-sm text-gray-500 mb-4">
      <%= length(@groups.inactive) %> players
    </p>
    <%= if @groups.inactive == [] do %>
      <p class="text-gray-500 italic">No inactive players on record.</p>
    <% else %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <%= for row <- @groups.inactive do %>
          <% card = Map.get(@cards, row.player.id, %{}) %>
          <.player_card
            player={row.player}
            team={row.team}
            link_target={Map.get(card, :link_target, "/mlb/players")}
            injury_badge={Map.get(card, :injury_badge, :grey)}
          />
        <% end %>
      </div>
    <% end %>
  </section>

  <SportsFanaticWeb.SEOComponents.date_nav
    prev_date={@prev_date}
    next_date={@next_date}
    base_path="/mlb/lineups"
  />
</section>

<script>
  (function() {
    // Mobile keyboard would pop on autofocus. Strip the attribute on
    // touch-only devices so the input is still scrollable without the
    // on-screen keyboard hijacking the viewport. Desktop / mouse users
    // keep autofocus and get an immediate cursor in the search box.
    try {
      var isTouch = window.matchMedia &&
        window.matchMedia('(hover: none) and (pointer: coarse)').matches;
      if (isTouch) {
        var el = document.getElementById('player-search-input');
        if (el) {
          el.removeAttribute('autofocus');
          el.blur();
        }
      }
    } catch (_e) {
      // matchMedia unavailable — keep autofocus, default to desktop behavior
    }

    var root = document.getElementById('player-search');
    if (!root) return;
    var input = document.getElementById('player-search-input');
    var list = document.getElementById('player-search-results');
    var rosterEl = document.getElementById('players-roster-data');
    if (!input || !list || !rosterEl) return;

    var roster = [];
    try {
      roster = JSON.parse(rosterEl.textContent || '[]');
    } catch (_e) {
      roster = [];
    }
    if (!Array.isArray(roster) || roster.length === 0) return;

    var MAX_VISIBLE = 200;

    function escapeHtml(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function(c) {
        return ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;'
        })[c];
      });
    }

    function matches(query) {
      if (!query || query.length < 1) return [];
      var needle = query.toLowerCase();
      var out = [];
      for (var i = 0; i < roster.length; i++) {
        var name = roster[i].full_name || '';
        if (name.toLowerCase().indexOf(needle) !== -1) {
          out.push(roster[i]);
          if (out.length === MAX_VISIBLE + 1) break;
        }
      }
      return out;
    }

    function render(items, totalQuery) {
      if (!items.length) {
        list.classList.add('hidden');
        list.innerHTML = '';
        input.setAttribute('aria-expanded', 'false');
        return;
      }
      list.classList.remove('hidden');
      input.setAttribute('aria-expanded', 'true');

      var shown = items.slice(0, MAX_VISIBLE);
      var html = '';
      for (var i = 0; i < shown.length; i++) {
        var p = shown[i];
        var href = escapeHtml(p.href || '/mlb/players');
        var name = escapeHtml(p.full_name);
        var abbr = escapeHtml(p.team_abbr || '');
        html += '<li role="option" data-name="' + name + '">' +
          '<a href="' + href + '" class="block px-4 py-2 hover:bg-blue-50 text-sm">' +
          '<span class="font-medium text-gray-900">' + name + '</span> ' +
          '<span class="text-gray-500">' + abbr + '</span>' +
          '</a></li>';
      }
      if (items.length > MAX_VISIBLE) {
        var extra = items.length - MAX_VISIBLE;
        html += '<li class="px-4 py-2 text-xs text-gray-500 italic">' +
          '+ ' + extra + ' more — refine your search to narrow down.' +
          '</li>';
      }
      list.innerHTML = html;
    }

    input.addEventListener('input', function(e) {
      var q = e.target.value || '';
      render(matches(q), q);
    });
    input.addEventListener('focus', function() {
      var q = input.value || '';
      if (q.length > 0) render(matches(q), q);
    });
    input.addEventListener('blur', function() {
      // Delay hiding so click on result still fires.
      setTimeout(function() {
        list.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
      }, 150);
    });
  })();
</script>
