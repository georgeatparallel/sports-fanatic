<SportsFanaticWeb.SEOComponents.breadcrumbs items={[
  %{label: "Home", href: "/"},
  %{label: "MLB Players"}
]} />

<section class="max-w-6xl mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-gray-900 mb-6">MLB Players</h1>
  <p class="text-gray-600 mb-8">
    Browse all MLB players with stats, scouting reports, and analysis.
  </p>

  <%!-- Today's Lineups Section --%>
  <%= if @lineup_players != [] do %>
    <div class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <h2 class="text-xl font-bold text-gray-900">Today's Lineups</h2>
        <span class="bg-green-100 text-green-800 text-xs font-semibold px-2.5 py-0.5 rounded-full">
          <%= length(@lineup_players) %> players
        </span>
        <span class="text-sm text-gray-500"><%= Calendar.strftime(@today, "%B %d, %Y") %></span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <%= for %{player: player, team: team, position: position, batting_order: order} <- @lineup_players do %>
          <a
            href={"/mlb/players/#{team.slug}/#{player.slug}"}
            class="bg-white rounded-lg shadow-sm p-4 border-2 border-green-200 hover:border-green-400 hover:shadow-md transition"
          >
            <div class="flex items-center gap-3">
              <%= if player.headshot_url do %>
                <img
                  src={player.headshot_url}
                  alt={player.full_name}
                  class="w-12 h-12 rounded-full object-cover"
                  loading="lazy"
                />
              <% else %>
                <div class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center text-green-700 font-bold">
                  <%= String.first(player.first_name || "") %><%= String.first(
                    player.last_name || ""
                  ) %>
                </div>
              <% end %>
              <div class="flex-1">
                <h3 class="font-semibold text-gray-900"><%= player.full_name %></h3>
                <p class="text-sm text-gray-500"><%= team.name %></p>
              </div>
              <div class="text-right">
                <span class="inline-block bg-gray-100 text-gray-700 text-xs font-medium px-2 py-0.5 rounded">
                  <%= position %>
                </span>
                <%= if order do %>
                  <p class="text-xs text-gray-400 mt-1">#<%= order %> in order</p>
                <% end %>
              </div>
            </div>
          </a>
        <% end %>
      </div>
    </div>

    <hr class="mb-8 border-gray-200" />
  <% end %>

  <%!-- All Players Section --%>
  <h2 class="text-xl font-bold text-gray-900 mb-4">All Players</h2>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <%= for %{player: player, team: team} <- @players do %>
      <a
        href={"/mlb/players/#{team.slug}/#{player.slug}"}
        class="bg-white rounded-lg shadow-sm p-4 border border-gray-100 hover:border-blue-300 hover:shadow-md transition"
      >
        <div class="flex items-center gap-3">
          <%= if player.headshot_url do %>
            <img
              src={player.headshot_url}
              alt={player.full_name}
              class="w-12 h-12 rounded-full object-cover"
              loading="lazy"
            />
          <% else %>
            <div class="w-12 h-12 rounded-full bg-gray-200 flex items-center justify-center text-gray-500 font-bold">
              <%= String.first(player.first_name || "") %><%= String.first(player.last_name || "") %>
            </div>
          <% end %>
          <div>
            <h2 class="font-semibold text-gray-900"><%= player.full_name %></h2>
            <p class="text-sm text-gray-500"><%= team.name %> - <%= player.position %></p>
          </div>
        </div>
      </a>
    <% end %>
  </div>

  <nav class="mt-8 flex justify-center gap-2" aria-label="Pagination">
    <%= if @page > 1 do %>
      <a
        href={"/mlb/players?page=#{@page - 1}"}
        class="px-4 py-2 bg-white border border-gray-300 rounded hover:bg-gray-50"
      >
        Previous
      </a>
    <% end %>
    <span class="px-4 py-2 text-gray-600">
      Page <%= @page %> of <%= ceil(@total / @per_page) %>
    </span>
    <%= if @page * @per_page < @total do %>
      <a
        href={"/mlb/players?page=#{@page + 1}"}
        class="px-4 py-2 bg-white border border-gray-300 rounded hover:bg-gray-50"
      >
        Next
      </a>
    <% end %>
  </nav>
</section>
