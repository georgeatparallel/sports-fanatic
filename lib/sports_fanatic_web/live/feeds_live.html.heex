<section class="max-w-4xl mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Manage Feeds</h1>
    <%= if @view == :list do %>
      <button
        phx-click="new_feed"
        class="bg-blue-600 text-white text-sm px-4 py-2 rounded-lg hover:bg-blue-700 font-medium transition shadow-sm"
      >
        Create New Feed
      </button>
    <% end %>
  </div>

  <%= if @view == :list do %>
    <%!-- Feed List View --%>
    <%= if @feeds == [] do %>
      <div class="text-center py-12 bg-white rounded-lg border border-gray-200">
        <p class="text-gray-500 text-lg mb-4">You have no feeds yet.</p>
        <p class="text-gray-400 text-sm mb-6">
          Create a feed to track news about your favorite players and teams.
        </p>
        <button
          phx-click="new_feed"
          class="bg-blue-600 text-white text-sm px-6 py-2 rounded-lg hover:bg-blue-700 font-medium transition"
        >
          Create Your First Feed
        </button>
      </div>
    <% else %>
      <div class="space-y-3">
        <%= for feed <- @feeds do %>
          <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-4 flex items-center justify-between">
            <div class="flex-1 min-w-0">
              <h3 class="text-lg font-semibold text-gray-900 truncate"><%= feed.name %></h3>
              <div class="flex items-center gap-4 mt-1 text-sm text-gray-500">
                <span><%= length(feed.player_ids) %> players</span>
                <span><%= length(feed.team_ids) %> teams</span>
                <%= if feed.last_researched_at do %>
                  <span>
                    Last researched: <%= Calendar.strftime(feed.last_researched_at, "%b %d, %Y %I:%M %p") %>
                  </span>
                <% end %>
              </div>
            </div>
            <div class="flex items-center gap-2 ml-4 flex-shrink-0">
              <button
                phx-click="view_feed_news"
                phx-value-id={feed.id}
                class="text-sm text-blue-600 hover:text-blue-800 font-medium px-3 py-1.5 rounded-md hover:bg-blue-50 transition"
              >
                View News
              </button>
              <.link
                patch={"/feeds/#{feed.id}"}
                class="text-sm text-gray-600 hover:text-gray-800 font-medium px-3 py-1.5 rounded-md hover:bg-gray-100 transition"
              >
                Edit
              </.link>
              <button
                phx-click="delete_feed"
                phx-value-id={feed.id}
                data-confirm="Delete this feed?"
                class="text-sm text-red-500 hover:text-red-700 font-medium px-3 py-1.5 rounded-md hover:bg-red-50 transition"
              >
                Delete
              </button>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%= if @view == :news do %>
    <%!-- Feed News View --%>
    <div class="mb-4">
      <button
        phx-click="cancel"
        class="text-sm text-gray-600 hover:text-gray-900 font-medium flex items-center gap-1"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
        </svg>
        Back to feeds
      </button>
    </div>

    <h2 class="text-xl font-bold text-gray-800 mb-4">
      News for "<%= @selected_feed.name %>"
    </h2>

    <%= if @feed_articles == [] do %>
      <p class="text-gray-500 py-8 text-center">No matching articles found today for this feed.</p>
    <% else %>
      <div class="space-y-4">
        <%= for item <- @feed_articles do %>
          <article class="bg-white rounded-lg shadow-sm border border-gray-100 p-5">
            <div class="flex items-center gap-2 mb-2">
              <.category_badge
                category={item["category"]}
                injury_area={item["injury_area"]}
                injury_grade={item["injury_grade"]}
              />
              <.sentiment_dot sentiment={item["sentiment"]} />
              <%= for tag <- (item["domain_tags"] || []) do %>
                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-indigo-50 text-indigo-700">
                  <%= tag %>
                </span>
              <% end %>
            </div>
            <h3 class="text-lg font-semibold text-gray-900"><%= item["title"] %></h3>
            <%= if item["ai_summary"] && item["ai_summary"] != "" do %>
              <p class="text-gray-600 mt-2 text-sm"><%= item["ai_summary"] %></p>
            <% end %>
            <%= if (item["players"] || []) != [] || (item["teams"] || []) != [] do %>
              <div class="flex flex-wrap gap-2 mt-3">
                <%= for player <- (item["players"] || []) do %>
                  <%= if player["team_slug"] && player["slug"] do %>
                    <a
                      href={"/mlb/players/#{player["team_slug"]}/#{player["slug"]}"}
                      class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-50 text-blue-700 hover:bg-blue-100 transition"
                    >
                      <%= player["full_name"] %>
                    </a>
                  <% else %>
                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-50 text-blue-700">
                      <%= player["full_name"] %>
                    </span>
                  <% end %>
                <% end %>
                <%= for team <- (item["teams"] || []) do %>
                  <a
                    href={"/mlb/teams/#{team["slug"]}"}
                    class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition"
                  >
                    <span class="font-bold"><%= team["abbreviation"] || team["name"] %></span>
                  </a>
                <% end %>
              </div>
            <% end %>
            <div class="flex gap-3 mt-3 text-xs text-gray-400">
              <%= if item["source_url"] do %>
                <a
                  href={item["source_url"]}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-blue-500 hover:text-blue-700"
                >
                  <%= item["author"] || "Read more" %> &rarr;
                </a>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%= if @view in [:edit, :create] do %>
    <%!-- Save reminder banner --%>
    <div class="bg-amber-50 border border-amber-200 rounded-lg px-4 py-2 mb-4 flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-amber-500 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
      </svg>
      <span class="text-sm font-medium text-amber-800">Don't forget to save changes</span>
    </div>

    <%!-- Feed Edit/Create View --%>
    <div class="mb-4">
      <button
        phx-click="cancel"
        class="text-sm text-gray-600 hover:text-gray-900 font-medium flex items-center gap-1"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
        </svg>
        Back to feeds
      </button>
    </div>

    <form phx-submit={if @creating, do: "create_feed", else: "save_feed"} class="space-y-6">
      <%!-- Feed Name --%>
      <div>
        <label for="feed-name" class="block text-sm font-medium text-gray-700 mb-1">Feed Name</label>
        <input
          id="feed-name"
          type="text"
          name="name"
          value={@feed_name}
          placeholder="My Fantasy Roster"
          autocomplete="off"
          class="w-full max-w-md rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        />
      </div>

      <%!-- Players Section --%>
      <div>
        <h3 class="text-lg font-semibold text-gray-800 mb-3">
          Players (<%= length(@feed_players) %>)
        </h3>

        <%!-- Player list --%>
        <%= if @feed_players != [] do %>
          <div class="space-y-2 mb-4">
            <%= for player <- @feed_players do %>
              <div class="flex items-center justify-between bg-gray-50 rounded-lg px-4 py-2">
                <div class="flex items-center gap-3">
                  <span class="font-medium text-gray-900"><%= player.full_name %></span>
                  <%= if player.position do %>
                    <span class="text-xs px-1.5 py-0.5 rounded bg-blue-100 text-blue-700">
                      <%= player.position %>
                    </span>
                  <% end %>
                  <%= if player.team_name do %>
                    <span class="text-sm text-gray-500"><%= player.team_name %></span>
                  <% end %>
                </div>
                <div class="flex items-center gap-2">
                  <%= if player.team_slug && player.slug do %>
                    <a
                      href={"/mlb/scouting/#{player.team_slug}/#{player.slug}"}
                      class="text-xs text-blue-600 hover:text-blue-800 font-medium"
                    >
                      Scouting
                    </a>
                    <a
                      href={"/mlb/players/#{player.team_slug}/#{player.slug}"}
                      class="text-xs text-blue-600 hover:text-blue-800 font-medium"
                    >
                      Profile
                    </a>
                  <% end %>
                  <button
                    type="button"
                    phx-click="remove_player"
                    phx-value-id={player.id}
                    class="text-gray-400 hover:text-red-500 transition"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                    </svg>
                  </button>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>

        <%!-- Add Player search --%>
        <div class="relative">
          <label class="block text-sm text-gray-600 mb-1">Add Player</label>
          <input
            type="text"
            name="query"
            value={@player_search}
            placeholder="Search players by name..."
            autocomplete="off"
            phx-keyup="search_players"
            phx-value-query={@player_search}
            phx-debounce="300"
            class="w-full max-w-md rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
          <%= if @player_results != [] do %>
            <div class="absolute z-10 mt-1 w-full max-w-md bg-white border border-gray-200 rounded-lg shadow-lg max-h-60 overflow-y-auto">
              <%= for player <- @player_results do %>
                <button
                  type="button"
                  phx-click="add_player"
                  phx-value-id={player.id}
                  class="w-full text-left px-4 py-2 hover:bg-blue-50 flex items-center justify-between border-b border-gray-50 last:border-b-0"
                >
                  <div>
                    <span class="font-medium text-gray-900"><%= player.full_name %></span>
                    <%= if player.team_name do %>
                      <span class="text-sm text-gray-500 ml-2"><%= player.team_name %></span>
                    <% end %>
                  </div>
                  <%= if player.position do %>
                    <span class="text-xs px-1.5 py-0.5 rounded bg-gray-100 text-gray-600">
                      <%= player.position %>
                    </span>
                  <% end %>
                </button>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <%!-- Teams Section --%>
      <div>
        <h3 class="text-lg font-semibold text-gray-800 mb-3">
          Teams (<%= length(@feed_teams) %>)
        </h3>

        <%!-- Team list --%>
        <%= if @feed_teams != [] do %>
          <div class="space-y-2 mb-4">
            <%= for team <- @feed_teams do %>
              <div class="flex items-center justify-between bg-gray-50 rounded-lg px-4 py-2">
                <div class="flex items-center gap-3">
                  <span class="font-medium text-gray-900"><%= team.name %></span>
                  <%= if team.abbreviation do %>
                    <span class="text-xs px-1.5 py-0.5 rounded bg-gray-100 text-gray-600">
                      <%= team.abbreviation %>
                    </span>
                  <% end %>
                </div>
                <div class="flex items-center gap-2">
                  <a
                    href={"/mlb/teams/#{team.slug}"}
                    class="text-xs text-blue-600 hover:text-blue-800 font-medium"
                  >
                    Team Page
                  </a>
                  <button
                    type="button"
                    phx-click="remove_team"
                    phx-value-id={team.id}
                    class="text-gray-400 hover:text-red-500 transition"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                    </svg>
                  </button>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>

        <%!-- Add Team search --%>
        <div class="relative">
          <label class="block text-sm text-gray-600 mb-1">Add Team</label>
          <input
            type="text"
            name="query"
            value={@team_search}
            placeholder="Search teams by name or abbreviation..."
            autocomplete="off"
            phx-keyup="search_teams"
            phx-debounce="300"
            class="w-full max-w-md rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
          <%= if @team_results != [] do %>
            <div class="absolute z-10 mt-1 w-full max-w-md bg-white border border-gray-200 rounded-lg shadow-lg max-h-60 overflow-y-auto">
              <%= for team <- @team_results do %>
                <button
                  type="button"
                  phx-click="add_team"
                  phx-value-id={team.id}
                  class="w-full text-left px-4 py-2 hover:bg-blue-50 flex items-center justify-between border-b border-gray-50 last:border-b-0"
                >
                  <span class="font-medium text-gray-900"><%= team.name %></span>
                  <%= if team.abbreviation do %>
                    <span class="text-xs px-1.5 py-0.5 rounded bg-gray-100 text-gray-600">
                      <%= team.abbreviation %>
                    </span>
                  <% end %>
                </button>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <%!-- Save / Cancel --%>
      <div class="flex items-center gap-3 pt-4 border-t border-gray-200">
        <button
          type="submit"
          class="bg-blue-600 text-white text-sm px-6 py-2 rounded-lg hover:bg-blue-700 font-medium transition shadow-sm"
        >
          <%= if @creating, do: "Create Feed", else: "Save Changes" %>
        </button>
        <button
          type="button"
          phx-click="cancel"
          class="text-sm text-gray-600 hover:text-gray-900 font-medium px-4 py-2"
        >
          Cancel
        </button>
      </div>
    </form>
  <% end %>
</section>
