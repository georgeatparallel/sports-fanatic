<SportsFanaticWeb.SEOComponents.breadcrumbs items={[
  %{label: "Home", href: "/"},
  %{label: "MLB Teams"}
]} />

<section class="max-w-6xl mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-gray-900 mb-6">MLB Teams</h1>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <%= for team <- @teams do %>
      <a
        href={"/mlb/teams/#{team.slug}"}
        class="bg-white rounded-lg shadow-sm p-5 border border-gray-100 hover:border-blue-300 hover:shadow-md transition"
      >
        <h2 class="font-semibold text-lg text-gray-900"><%= team.name %></h2>
        <p class="text-sm text-gray-500"><%= team.city %></p>
        <p class="text-xs text-gray-400 mt-1"><%= team.league %> - <%= team.division %></p>
      </a>
    <% end %>
  </div>
</section>
