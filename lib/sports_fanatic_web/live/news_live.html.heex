<SportsFanaticWeb.SEOComponents.breadcrumbs items={[
  %{label: "Home", href: "/"},
  %{label: "Baseball", href: "/mlb/teams"},
  %{label: "News", href: "/mlb/news"},
  %{label: @formatted_date}
]} />

<section class="max-w-4xl mx-auto px-4 py-8">
  <%!-- Chat Interface (feature-flagged) --%>
  <%= if @chat_enabled do %>
    <div class="sticky top-0 z-10 bg-white shadow-sm border border-gray-200 rounded-lg mb-4 -mx-4 px-4 pt-2 pb-2">
      <%!-- Chat header --%>
      <div class="flex items-center justify-between mb-2">
        <h3 class="text-sm font-semibold text-gray-700">News Research Agent</h3>
        <div class="flex items-center gap-2">
          <%= if @agent_running do %>
            <button
              phx-click="cancel_agent"
              class="text-xs text-red-500 hover:text-red-700 font-medium px-2 py-1 rounded border border-red-200 hover:bg-red-50"
            >
              Cancel
            </button>
          <% end %>
          <%= if @chat_messages != [] do %>
            <button
              phx-click="clear_chat"
              class="text-xs text-gray-500 hover:text-gray-700 font-medium"
            >
              Clear Chat
            </button>
          <% end %>
        </div>
      </div>

      <%!-- Chat messages thread --%>
      <%= if @chat_messages != [] do %>
        <div
          class="max-h-64 overflow-y-auto mb-2 space-y-2 px-1"
          id="chat-messages"
          phx-hook="ScrollBottom"
        >
          <%= for msg <- @chat_messages do %>
            <div
              id={"chat-msg-#{msg.id}"}
              class={[
                "flex",
                if(msg.role == "user", do: "justify-end", else: "justify-start")
              ]}
            >
              <div class={[
                "max-w-[80%] rounded-lg px-3 py-2 text-sm",
                cond do
                  msg.role == "user" -> "bg-blue-500 text-white"
                  msg.role == "progress" -> "bg-gray-100 text-gray-600 italic"
                  true -> "bg-gray-50 text-gray-800 border border-gray-200"
                end
              ]}>
                <%= if msg.role == "progress" do %>
                  <div class="flex items-center gap-2">
                    <svg
                      class="animate-spin h-3 w-3 text-gray-400"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                    >
                      <circle
                        class="opacity-25"
                        cx="12"
                        cy="12"
                        r="10"
                        stroke="currentColor"
                        stroke-width="4"
                      >
                      </circle>
                      <path
                        class="opacity-75"
                        fill="currentColor"
                        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
                      >
                      </path>
                    </svg>
                    <span><%= sanitize_chat(msg.content) %></span>
                  </div>
                <% else %>
                  <%= sanitize_chat(msg.content) %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <%!-- Chat articles from last agent response --%>
      <%= if @chat_articles != [] do %>
        <div class="mb-2 space-y-1">
          <%= for article <- @chat_articles do %>
            <div class="bg-white border border-gray-100 rounded px-3 py-2 text-sm">
              <div class="flex items-center gap-2">
                <span class="font-medium text-gray-900 truncate"><%= article["title"] %></span>
                <%= if article["category"] do %>
                  <span class="text-xs px-1.5 py-0.5 rounded bg-gray-100 text-gray-600">
                    <%= article["category"] %>
                  </span>
                <% end %>
              </div>
              <%= if article["ai_summary"] do %>
                <p class="text-xs text-gray-500 mt-1 line-clamp-2">
                  <%= article["ai_summary"] %>
                </p>
              <% end %>
              <%= if article["source_url"] do %>
                <a
                  href={article["source_url"]}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs text-blue-500 hover:text-blue-700 mt-1 inline-block"
                >
                  <%= article["author"] || "Read more" %> &rarr;
                </a>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%!-- Chat input --%>
      <form phx-submit="submit_chat" class="relative">
        <input
          type="text"
          name="message"
          value={@chat_input}
          placeholder={
            if @current_user,
              do: "Ask about MLB news, players, or trades...",
              else: "Log in to use the news chatbot..."
          }
          disabled={@agent_running || is_nil(@current_user)}
          autocomplete="off"
          phx-debounce="300"
          class={[
            "w-full rounded-lg border border-gray-300 px-3 py-2 pr-10 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
            if(@agent_running, do: "bg-gray-50 cursor-not-allowed", else: "")
          ]}
        />
        <button
          type="submit"
          disabled={@agent_running || is_nil(@current_user)}
          class="absolute right-2 top-1/2 -translate-y-1/2 text-blue-500 hover:text-blue-700 disabled:text-gray-300"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z" />
          </svg>
        </button>
      </form>
      <div class="flex items-center justify-between mt-1">
        <span class="text-xs text-gray-400">
          <%= if @agent_running, do: "Searching...", else: "Enter to search" %>
        </span>
      </div>
    </div>
  <% else %>
    <%!-- Legacy Sticky Command Input --%>
    <div class="sticky top-0 z-10 bg-white shadow-sm border-b border-gray-200 pb-2 mb-4 -mx-4 px-4 pt-2">
      <form phx-submit="submit_command" class="relative">
        <div class="relative">
          <textarea
            name="input"
            value={@command_input}
            rows="2"
            autofocus
            phx-keydown="submit_command"
            phx-key="Enter"
            placeholder={
              if @current_user,
                do:
                  "Type /settings-apply \"your description\" to create an agent, or search the feed...",
                else: "Search the feed, or log in to use agent commands..."
            }
            class="w-full rounded-lg border border-gray-300 px-3 py-2 pr-8 text-sm resize-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            phx-debounce="300"
          ><%= @command_input %></textarea>
          <%= if @search_query != "" or @command_input != "" do %>
            <button
              type="button"
              phx-click="clear_search"
              class="absolute top-2 right-2 text-gray-400 hover:text-gray-600"
              title="Clear"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                  clip-rule="evenodd"
                />
              </svg>
            </button>
          <% end %>
        </div>
        <div class="flex items-center justify-between mt-1">
          <span class="text-xs text-gray-400">
            Enter to search &middot; Shift+Enter for newline
          </span>
          <div class="flex items-center gap-3">
            <%= if @search_query != "" do %>
              <button
                type="button"
                phx-click="clear_search"
                class="text-xs text-red-500 hover:text-red-700 font-medium"
              >
                Clear Search
              </button>
            <% end %>
            <button type="submit" class="text-xs text-blue-600 hover:text-blue-800 font-medium">
              Submit
            </button>
          </div>
        </div>
      </form>
    </div>
  <% end %>

  <%!-- Feed --%>
  <SportsFanaticWeb.SEOComponents.date_nav
    prev_date={@prev_date}
    next_date={@next_date}
    base_path="/mlb/news"
    link_type={:patch}
  />

  <h1 class="text-3xl font-bold text-gray-900 mb-6">
    MLB News &mdash; <%= @formatted_date %>
  </h1>

  <%!-- Search indicator --%>
  <%= if @search_query != "" do %>
    <div class="mb-4 bg-blue-50 border border-blue-200 rounded-lg px-4 py-2 flex items-center justify-between">
      <span class="text-sm text-blue-800">
        Showing <strong><%= length(@filtered_feed || []) %></strong>
        results for "<strong><%= @search_query %></strong>"
      </span>
      <button
        phx-click="clear_search"
        class="inline-flex items-center gap-1 px-3 py-1 bg-white border border-blue-300 rounded-md text-sm text-blue-700 hover:bg-blue-100 font-medium"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
            clip-rule="evenodd"
          />
        </svg>
        Clear Search
      </button>
    </div>
  <% end %>

  <% display_feed = @filtered_feed || @feed %>

  <%= if Enum.empty?(display_feed) do %>
    <p class="text-gray-500">
      <%= if @search_query != "",
        do: "No articles match your search.",
        else: "No news for this date." %>
    </p>
  <% else %>
    <div class="space-y-4" id="news-feed" phx-update="replace">
      <%= for item <- display_feed do %>
        <article
          id={"news-#{item["id"]}"}
          class="bg-white rounded-lg shadow-sm border border-gray-100 p-5"
        >
          <div class="flex items-center gap-2 mb-2">
            <.category_badge
              category={item["category"]}
              injury_area={item["injury_area"]}
              injury_grade={item["injury_grade"]}
            />
            <.sentiment_dot sentiment={item["sentiment"]} />

            <%!-- Domain tags --%>
            <%= for tag <- (item["domain_tags"] || []) do %>
              <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-indigo-50 text-indigo-700">
                <%= tag %>
              </span>
            <% end %>
          </div>

          <h2 class="text-lg font-semibold text-gray-900"><%= item["title"] %></h2>

          <%= if item["ai_summary"] && item["ai_summary"] != "" do %>
            <p class="text-gray-600 mt-2 text-sm"><%= item["ai_summary"] %></p>
          <% end %>

          <%= if item["body"] && item["body"] != "" do %>
            <p class="text-gray-500 mt-2 text-sm"><%= item["body"] %></p>
          <% else %>
            <%= if item["summary"] && item["summary"] != "" do %>
              <p class="text-gray-500 mt-2 text-sm"><%= item["summary"] %></p>
            <% end %>
          <% end %>

          <%!-- Entity data: players and teams --%>
          <%= if (item["players"] || []) != [] || (item["teams"] || []) != [] do %>
            <div class="flex flex-wrap gap-2 mt-3">
              <%!-- Player links --%>
              <%= for player <- (item["players"] || []) do %>
                <%= if player["team_slug"] && player["slug"] do %>
                  <a
                    href={"/mlb/players/#{player["team_slug"]}/#{player["slug"]}"}
                    class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-50 text-blue-700 hover:bg-blue-100 transition"
                  >
                    <%= player["full_name"] %>
                  </a>
                <% else %>
                  <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-50 text-blue-700">
                    <%= player["full_name"] %>
                  </span>
                <% end %>
              <% end %>

              <%!-- Team badges with abbreviation and league --%>
              <%= for team <- (item["teams"] || []) do %>
                <a
                  href={"/mlb/teams/#{team["slug"]}"}
                  class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition"
                >
                  <span class="font-bold"><%= team["abbreviation"] || team["name"] %></span>
                  <%= if team["league"] do %>
                    <span class={[
                      "px-1 py-0.5 rounded text-xs font-medium",
                      if(team["league"] == "AL",
                        do: "bg-red-100 text-red-600",
                        else: "bg-blue-100 text-blue-600"
                      )
                    ]}>
                      <%= team["league"] %>
                    </span>
                  <% end %>
                </a>
              <% end %>
            </div>
          <% end %>

          <div class="flex gap-3 mt-3 text-xs text-gray-400">
            <%= if item["source_url"] do %>
              <a
                href={item["source_url"]}
                target="_blank"
                rel="noopener noreferrer"
                class="text-blue-500 hover:text-blue-700"
              >
                <%= item["author"] || "Read more" %> &rarr;
              </a>
            <% else %>
              <%= if item["author"] do %>
                <span><%= item["author"] %></span>
              <% end %>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  <% end %>

  <SportsFanaticWeb.SEOComponents.date_nav
    prev_date={@prev_date}
    next_date={@next_date}
    base_path="/mlb/news"
    link_type={:patch}
  />
</section>
