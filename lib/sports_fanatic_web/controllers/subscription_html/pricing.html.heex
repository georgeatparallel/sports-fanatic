<section class="max-w-4xl mx-auto px-4 py-12">
  <div class="text-center mb-12">
    <h1 class="text-3xl font-bold text-gray-900 mb-4">Sports Fan Agent Premium</h1>
    <p class="text-lg text-gray-600 max-w-2xl mx-auto">
      Unlock full scouting reports, Game Day Magazines, real-time predictions, and subscriber-only analysis.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-2xl mx-auto">
    <div class="bg-white rounded-xl shadow-lg border-2 border-gray-200 p-8">
      <h2 class="text-xl font-bold text-gray-900">Monthly</h2>
      <div class="mt-4 mb-6">
        <span class="text-4xl font-bold text-gray-900">$9.99</span>
        <span class="text-gray-500">/month</span>
      </div>
      <ul class="space-y-3 text-sm text-gray-600 mb-8">
        <li class="flex items-center gap-2"><span class="text-green-500">&#x2713;</span> 7-day free trial</li>
        <li class="flex items-center gap-2"><span class="text-green-500">&#x2713;</span> Full scouting reports</li>
        <li class="flex items-center gap-2"><span class="text-green-500">&#x2713;</span> Game Day Magazines</li>
        <li class="flex items-center gap-2"><span class="text-green-500">&#x2713;</span> Real-time predictions</li>
        <li class="flex items-center gap-2"><span class="text-green-500">&#x2713;</span> Archive access</li>
      </ul>
      <form action="/subscribe/checkout" method="post">
        <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
        <input type="hidden" name="plan" value="monthly" />
        <button type="submit" class="w-full bg-blue-600 text-white font-semibold py-3 rounded-lg hover:bg-blue-700 transition">
          Start Free Trial
        </button>
      </form>
    </div>

    <div class="bg-white rounded-xl shadow-lg border-2 border-blue-500 p-8 relative">
      <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-blue-500 text-white text-xs font-bold px-4 py-1 rounded-full">
        BEST VALUE
      </span>
      <h2 class="text-xl font-bold text-gray-900">Yearly</h2>
      <div class="mt-4 mb-6">
        <span class="text-4xl font-bold text-gray-900">$79.99</span>
        <span class="text-gray-500">/year</span>
        <p class="text-sm text-green-600 font-medium mt-1">Save 33%</p>
      </div>
      <ul class="space-y-3 text-sm text-gray-600 mb-8">
        <li class="flex items-center gap-2"><span class="text-green-500">&#x2713;</span> 7-day free trial</li>
        <li class="flex items-center gap-2"><span class="text-green-500">&#x2713;</span> Everything in Monthly</li>
        <li class="flex items-center gap-2"><span class="text-green-500">&#x2713;</span> Priority support</li>
        <li class="flex items-center gap-2"><span class="text-green-500">&#x2713;</span> Early access to features</li>
      </ul>
      <form action="/subscribe/checkout" method="post">
        <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
        <input type="hidden" name="plan" value="yearly" />
        <button type="submit" class="w-full bg-blue-600 text-white font-semibold py-3 rounded-lg hover:bg-blue-700 transition">
          Start Free Trial
        </button>
      </form>
    </div>
  </div>
</section>
