<section class="bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900 text-white py-20">
  <div class="max-w-6xl mx-auto px-4">
    <h1 class="text-5xl font-bold mb-4">Sports Fanatic</h1>
    <p class="text-xl text-blue-200 mb-8 max-w-2xl">
      AI-powered MLB analysis. Scouting reports, Game Day Magazines, hit and HR predictions
      for every player, every game.
    </p>
    <div class="flex gap-4">
      <a href="/subscribe" class="bg-blue-500 hover:bg-blue-400 text-white font-semibold px-8 py-3 rounded-lg transition">
        Start Free Trial
      </a>
      <a href="/mlb/players" class="border border-blue-400 text-blue-200 font-semibold px-8 py-3 rounded-lg hover:bg-blue-800/50 transition">
        Browse Players
      </a>
    </div>
  </div>
</section>

<section class="max-w-6xl mx-auto px-4 py-12">
  <h2 class="text-2xl font-bold text-gray-900 mb-6">Today's Games - <%= Calendar.strftime(@today, "%B %d, %Y") %></h2>

  <%= if Enum.empty?(@games) do %>
    <p class="text-gray-500">No games scheduled for today.</p>
  <% else %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <%= for game <- @games do %>
        <div class="bg-white rounded-lg shadow-md p-4 border border-gray-100">
          <div class="flex justify-between items-center">
            <div class="text-center flex-1">
              <p class="font-semibold text-gray-900"><%= game.away_name %></p>
              <p class="text-xs text-gray-500">Away</p>
            </div>
            <span class="text-gray-400 font-bold text-lg mx-4">@</span>
            <div class="text-center flex-1">
              <p class="font-semibold text-gray-900"><%= game.home_name %></p>
              <p class="text-xs text-gray-500">Home</p>
            </div>
          </div>
          <div class="mt-3 pt-3 border-t border-gray-100 text-sm text-gray-600">
            <p><%= game.venue_name %></p>
            <%= if game.away_probable_pitcher || game.home_probable_pitcher do %>
              <p class="mt-1">
                <span class="font-medium"><%= game.away_probable_pitcher || "TBD" %></span>
                vs
                <span class="font-medium"><%= game.home_probable_pitcher || "TBD" %></span>
              </p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
    <div class="mt-4">
      <a href={"/mlb/lineups/#{Date.to_iso8601(@today)}"} class="text-blue-600 hover:text-blue-800 font-medium">
        View full lineups &rarr;
      </a>
    </div>
  <% end %>
</section>

<section class="bg-gray-50 py-12">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Latest News</h2>
    <%= if Enum.empty?(@recent_news) do %>
      <p class="text-gray-500">No recent news.</p>
    <% else %>
      <div class="space-y-4">
        <%= for item <- @recent_news do %>
          <article class="bg-white rounded-lg shadow-sm p-4 border border-gray-100">
            <a href={"/mlb/news/#{Date.to_iso8601(item.published_date)}/#{item.slug}"} class="hover:text-blue-600">
              <h3 class="font-semibold text-gray-900"><%= item.title %></h3>
            </a>
            <%= if item.summary do %>
              <p class="text-gray-600 text-sm mt-1"><%= String.slice(item.summary, 0, 200) %></p>
            <% end %>
            <p class="text-gray-400 text-xs mt-2"><%= Calendar.strftime(item.published_date, "%b %d, %Y") %></p>
          </article>
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<section class="max-w-6xl mx-auto px-4 py-12">
  <h2 class="text-2xl font-bold text-gray-900 mb-6">MLB Teams</h2>
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3">
    <%= for team <- @teams do %>
      <a href={"/mlb/teams/#{team.slug}"} class="bg-white rounded-lg shadow-sm p-3 border border-gray-100 hover:border-blue-300 hover:shadow-md transition text-center">
        <p class="font-medium text-gray-900 text-sm"><%= team.name %></p>
        <p class="text-gray-500 text-xs"><%= team.league %> - <%= team.division %></p>
      </a>
    <% end %>
  </div>
</section>

<SportsFanaticWeb.SEOComponents.subscribe_cta />
