<SportsFanaticWeb.SEOComponents.breadcrumbs items={[
  %{label: "Home", href: "/"},
  %{label: "Predictions", href: "/predictions"},
  %{label: @team.name, href: "/mlb/teams/#{@team.slug}"},
  %{label: "#{@player.full_name} Scouting Report"}
]} />

<article class="max-w-4xl mx-auto px-4 py-8">
  <SportsFanaticWeb.PredictionComponents.game_card_panel card={assigns[:game_card]} />
  <SportsFanaticWeb.PredictionComponents.today_hit_banner prediction={
    assigns[:today_hit_prediction]
  } />

  <header class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900">
      Scouting Report: <%= @player.full_name %>
    </h1>
    <p class="text-lg text-gray-600">
      <a href={"/mlb/teams/#{@team.slug}"} class="text-blue-600 hover:text-blue-800">
        <%= @team.name %>
      </a>
      | <%= @player.position %>
    </p>
  </header>

  <%= if @report do %>
    <div class="space-y-6">
      <%!-- Grade + injury chip + summary --%>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
        <div class="flex items-center gap-4 mb-4">
          <div class="text-center">
            <span class="text-4xl font-bold text-blue-600"><%= @report.overall_grade %></span>
            <p class="text-xs text-gray-500">Overall</p>
          </div>
          <%= if @report.injury_risk && @report.injury_risk != "healthy" do %>
            <span class="px-3 py-1 bg-red-100 text-red-800 rounded-full text-sm font-medium">
              <%= @report.injury_risk %>
            </span>
          <% end %>
        </div>

        <h2 class="text-lg font-semibold text-gray-900 mb-2">Summary</h2>
        <p class="text-gray-700 leading-relaxed"><%= @report.summary %></p>
      </div>

      <%!-- Predictions + Injury detail (two-up on md+) --%>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <section class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">Predictions</h2>
          <%= if @report.hit_probability do %>
            <div class="mb-4">
              <div class="flex justify-between text-sm mb-1">
                <span class="text-gray-600">Hit Probability</span>
                <span class="font-bold text-green-600">
                  <%= Float.round((@report.hit_probability || 0) * 100, 1) %>%
                </span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-2">
                <div
                  class="bg-green-500 h-2 rounded-full"
                  style={"width: #{(@report.hit_probability || 0) * 100}%"}
                >
                </div>
              </div>
            </div>
          <% end %>
          <%= if @report.hr_probability do %>
            <div>
              <div class="flex justify-between text-sm mb-1">
                <span class="text-gray-600">HR Probability</span>
                <span class="font-bold text-purple-600">
                  <%= Float.round((@report.hr_probability || 0) * 100, 1) %>%
                </span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-2">
                <div
                  class="bg-purple-500 h-2 rounded-full"
                  style={"width: #{min((@report.hr_probability || 0) * 100 * 5, 100)}%"}
                >
                </div>
              </div>
            </div>
          <% end %>
          <%= if is_nil(@report.hit_probability) and is_nil(@report.hr_probability) do %>
            <p class="text-sm text-gray-500">
              No probability data available for this report.
            </p>
          <% end %>
          <%= if @report.confidence_modifier do %>
            <p class="text-sm text-gray-500 mt-3">
              Confidence modifier: <%= @report.confidence_modifier %>
            </p>
          <% end %>
        </section>

        <section class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">Injury Status</h2>
          <div class="flex items-center gap-2 mb-2">
            <span class={"px-2 py-1 rounded-full text-sm font-medium #{if @report.injury_risk == "healthy", do: "bg-green-100 text-green-800", else: "bg-red-100 text-red-800"}"}>
              <%= @report.injury_risk || "healthy" %>
            </span>
          </div>
          <%= if @report.injury_detail do %>
            <p class="text-sm text-gray-600"><%= @report.injury_detail %></p>
          <% end %>
        </section>
      </div>

      <%!-- Strengths + weaknesses --%>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <%= if @report.strengths && length(@report.strengths) > 0 do %>
          <section class="bg-white rounded-lg shadow-sm border border-green-200 p-6">
            <h2 class="text-lg font-semibold text-green-700 mb-3">Strengths</h2>
            <ul class="space-y-2">
              <%= for s <- @report.strengths do %>
                <li class="flex items-start gap-2 text-gray-700 text-sm">
                  <span class="text-green-500 mt-0.5">+</span>
                  <span><%= s %></span>
                </li>
              <% end %>
            </ul>
          </section>
        <% end %>

        <%= if @report.weaknesses && length(@report.weaknesses) > 0 do %>
          <section class="bg-white rounded-lg shadow-sm border border-red-200 p-6">
            <h2 class="text-lg font-semibold text-red-700 mb-3">Weaknesses</h2>
            <ul class="space-y-2">
              <%= for w <- @report.weaknesses do %>
                <li class="flex items-start gap-2 text-gray-700 text-sm">
                  <span class="text-red-500 mt-0.5">-</span>
                  <span><%= w %></span>
                </li>
              <% end %>
            </ul>
          </section>
        <% end %>
      </div>

      <p class="text-sm text-gray-400">
        Report generated: <%= Calendar.strftime(@report.report_date, "%B %d, %Y") %>
        <%= if @report.sources_count && @report.sources_count > 0 do %>
          | Sources: <%= @report.sources_count %>
        <% end %>
        <%= if @report.model_version do %>
          | Model: <%= @report.model_version %>
        <% end %>
      </p>
    </div>
  <% else %>
    <div class="bg-gray-50 rounded-lg p-8 text-center">
      <p class="text-gray-500 mb-2">
        No scouting report available yet for <%= @player.full_name %>.
      </p>
      <p class="text-sm text-gray-400">
        Reports are generated daily for players in confirmed lineups.
      </p>
    </div>
  <% end %>

  <SportsFanaticWeb.SEOComponents.subscribe_cta return_to={"/mlb/scouting/#{@team.slug}/#{@player.slug}"} />

  <div class="mt-6">
    <a
      href={"/mlb/players/#{@team.slug}/#{@player.slug}"}
      class="text-blue-600 hover:text-blue-800"
    >
      &larr; Back to player profile
    </a>
  </div>
</article>
