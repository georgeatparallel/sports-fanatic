<section class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-blue-900 to-indigo-900 text-white">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-10 left-10 text-8xl">&#9918;</div>
    <div class="absolute bottom-10 right-10 text-8xl">&#9918;</div>
  </div>
  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-16 sm:py-24">
    <div class="max-w-2xl">
      <p class="text-blue-300 font-semibold text-sm uppercase tracking-wider mb-3">AI-Powered MLB Intelligence</p>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold mb-5 leading-tight">
        Your Edge for<br/>
        <span class="bg-gradient-to-r from-blue-400 to-cyan-300 bg-clip-text text-transparent">Every Game</span>
      </h1>
      <p class="text-lg sm:text-xl text-blue-200 mb-8 leading-relaxed">
        Scouting reports, Game Day Magazines, hit and HR predictions &mdash;
        generated by AI for every player, every matchup, every day.
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href="/subscribe" class="bg-blue-500 hover:bg-blue-400 text-white font-semibold px-8 py-3.5 rounded-xl transition shadow-lg shadow-blue-500/25 text-center">
          Start Free Trial
        </a>
        <a href="/mlb/players" class="border border-blue-400/50 text-blue-200 font-semibold px-8 py-3.5 rounded-xl hover:bg-white/10 transition text-center">
          Browse Players
        </a>
      </div>
      <p class="text-blue-300/60 text-sm mt-4">7-day free trial &middot; Cancel anytime</p>
    </div>
  </div>
</section>

<section class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-6">
    <h2 class="text-xl sm:text-2xl font-bold text-gray-900">
      Today's Games
      <span class="text-gray-400 font-normal text-base ml-1"><%= Calendar.strftime(@today, "%B %d, %Y") %></span>
    </h2>
    <a href={"/mlb/lineups/#{Date.to_iso8601(@today)}"} class="text-blue-600 hover:text-blue-800 text-sm font-medium">
      View full lineups &rarr;
    </a>
  </div>

  <%= if Enum.empty?(@games) do %>
    <div class="bg-white rounded-xl border border-gray-200 p-8 text-center">
      <p class="text-gray-400 text-lg">No games scheduled for today.</p>
    </div>
  <% else %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <%= for game <- @games do %>
        <div class="bg-white rounded-xl border border-gray-200 p-5 hover:shadow-md hover:border-gray-300 transition group">
          <div class="flex items-center justify-between gap-3">
            <div class="flex-1 min-w-0">
              <p class="font-semibold text-gray-900 truncate"><%= game.away_name %></p>
              <p class="text-xs text-gray-400 uppercase tracking-wide">Away</p>
            </div>
            <div class="flex-shrink-0 bg-gray-100 rounded-full w-8 h-8 flex items-center justify-center">
              <span class="text-gray-400 font-bold text-xs">VS</span>
            </div>
            <div class="flex-1 min-w-0 text-right">
              <p class="font-semibold text-gray-900 truncate"><%= game.home_name %></p>
              <p class="text-xs text-gray-400 uppercase tracking-wide">Home</p>
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-gray-100 text-sm text-gray-500 space-y-1">
            <p class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
              <%= game.venue_name %>
            </p>
            <%= if game.away_probable_pitcher || game.home_probable_pitcher do %>
              <p class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0" /></svg>
                <span class="font-medium text-gray-700"><%= game.away_probable_pitcher || "TBD" %></span>
                <span class="text-gray-300">vs</span>
                <span class="font-medium text-gray-700"><%= game.home_probable_pitcher || "TBD" %></span>
              </p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</section>

<section class="bg-white border-y border-gray-200 py-10 sm:py-14">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-6">
      <h2 class="text-xl sm:text-2xl font-bold text-gray-900">Latest News</h2>
      <a href={"/mlb/news/#{Date.to_iso8601(@today)}"} class="text-blue-600 hover:text-blue-800 text-sm font-medium">
        All news &rarr;
      </a>
    </div>
    <%= if Enum.empty?(@recent_news) do %>
      <div class="bg-gray-50 rounded-xl border border-gray-200 p-8 text-center">
        <p class="text-gray-400">No recent news available.</p>
      </div>
    <% else %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <%= for item <- @recent_news do %>
          <article class="bg-gray-50 rounded-xl p-5 hover:bg-gray-100 transition group">
            <a href={"/mlb/news/#{Date.to_iso8601(item.published_date)}/#{item.slug}"} class="block">
              <h3 class="font-semibold text-gray-900 group-hover:text-blue-600 transition leading-snug"><%= item.title %></h3>
              <%= if item.summary do %>
                <p class="text-gray-500 text-sm mt-2 line-clamp-2"><%= String.slice(item.summary, 0, 200) %></p>
              <% end %>
              <p class="text-gray-400 text-xs mt-3"><%= Calendar.strftime(item.published_date, "%b %d, %Y") %></p>
            </a>
          </article>
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<section class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
  <h2 class="text-xl sm:text-2xl font-bold text-gray-900 mb-6">MLB Teams</h2>
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
    <%= for team <- @teams do %>
      <a href={"/mlb/teams/#{team.slug}"} class="bg-white rounded-xl border border-gray-200 p-4 hover:border-blue-400 hover:shadow-md transition text-center group">
        <p class="font-semibold text-gray-900 group-hover:text-blue-600 transition text-sm"><%= team.name %></p>
        <p class="text-gray-400 text-xs mt-0.5"><%= team.league %> &middot; <%= team.division %></p>
      </a>
    <% end %>
  </div>
</section>

<section class="px-4 sm:px-6 pb-14">
  <div class="max-w-4xl mx-auto">
    <div class="bg-gradient-to-r from-blue-600 to-indigo-600 rounded-2xl p-8 sm:p-12 text-white text-center shadow-xl shadow-blue-600/10">
      <h3 class="text-2xl sm:text-3xl font-bold mb-3">Unlock Premium Intelligence</h3>
      <p class="text-blue-100 mb-8 max-w-xl mx-auto leading-relaxed">
        Full scouting reports, Game Day Magazines, real-time hit &amp; HR predictions,
        and subscriber-only analysis for every matchup.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-3">
        <a href="/subscribe" class="bg-white text-blue-700 font-semibold px-8 py-3.5 rounded-xl hover:bg-blue-50 transition shadow-lg">
          Start Free Trial
        </a>
        <a href="/auth/login" class="border border-white/40 text-white font-semibold px-8 py-3.5 rounded-xl hover:bg-white/10 transition">
          Sign In
        </a>
      </div>
      <p class="text-blue-200/60 text-sm mt-4">$9.99/mo or $79.99/yr &middot; 7-day free trial</p>
    </div>
  </div>
</section>
